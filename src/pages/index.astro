---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../data/site';
import { getAllWork } from '../lib/work';

const all = await getAllWork();
const featuredPhoto = all.filter((w) => w.featured && w.kind === 'Photography');
const featuredOther = all.filter((w) => w.featured && w.kind !== 'Photography');
const selected = [...featuredPhoto, ...featuredOther];
const counts = {
  '/photography/': all.filter((w) => w.kind === 'Photography').length,
  '/projects/': all.filter((w) => w.kind !== 'Photography').length,
};
const pad = (n: number) => String(n).padStart(2, '0');
const hero = site.hero.image;
---
<Base image={hero} sheet="Index">
  <section id="intro" class="hero wrap" aria-labelledby="home-title">
    <div class="hero__heading">
      <div class="hero__eyebrow">
        <span class="label">Photography / Design / Engineering</span>
        <span class="label">Independent practice · Sweden</span>
      </div>
      <h1 id="home-title">Axel <span>Tidehorn<span class="hero__dot">.</span></span></h1>
      <p>Photographs, things made, and things in progress.</p>
    </div>
    <div class="hero__composition">
      <figure class="hero__figure">
        <Image
          src={hero}
          alt={site.hero.alt}
          widths={[800, 1200, 1800, 2400, 3000]}
          sizes="(min-width: 1000px) 73vw, 100vw"
          quality={86}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          <span class="label">01 / Featured photograph</span>
          {site.hero.placeholder && <span class="badge">Placeholder</span>}
        </figcaption>
      </figure>
      <aside class="hero__side" aria-label="Explore the portfolio">
        <div class="hero__side-top"><span class="label">AT / Portfolio</span><span aria-hidden="true">↗</span></div>
        <div>
          <p>{site.intro}</p>
          <nav aria-label="Explore work">
            {site.nav.slice(0, 2).map((n) => (
              <a href={n.href}>
                <span>{n.label}</span>
                <span class="label">{pad(counts[n.href as keyof typeof counts])} ↗</span>
              </a>
            ))}
          </nav>
        </div>
      </aside>
    </div>
  </section>

  <section id="work" class="selected wrap" aria-labelledby="sel">
    <header class="section-heading">
      <div class="section-heading__marker"><span class="label">02 / The work</span><span aria-hidden="true">↘</span></div>
      <div class="section-heading__copy">
        <h2 id="sel">Selected work</h2>
        <span class="label">{pad(selected.length)} selected projects and photo series</span>
      </div>
    </header>
    <div class="selected__grid">
      {selected.map((w, i) => (
        <WorkCard
          href={w.href}
          no={pad(i + 1)}
          title={w.title}
          kind={w.kind}
          summary={w.summary}
          cover={w.cover}
          placeholder={w.placeholder}
          sizes={i === 0 ? '(min-width: 760px) 75vw, 100vw' : '(min-width: 760px) 46vw, 100vw'}
        />
      ))}
    </div>
    <div class="selected__links">
      <a href="/photography/">All photography ↗</a>
      <a href="/projects/">All projects ↗</a>
    </div>
  </section>

  <section id="directory" class="index wrap" aria-labelledby="idx">
    <header class="section-heading section-heading--index">
      <div class="section-heading__marker"><span class="label">03 / Directory</span><span aria-hidden="true">↗</span></div>
      <div class="section-heading__copy">
        <h2 id="idx">Index of work</h2>
        <span class="label">{pad(all.length)} entries</span>
      </div>
    </header>
    <table>
      <thead>
        <tr><th scope="col" class="label">No.</th><th scope="col" class="label">Title</th><th scope="col" class="label">Type</th><th scope="col" class="label">Status</th></tr>
      </thead>
      <tbody>
        {all.map((w, i) => (
          <tr>
            <td class="label">{pad(i + 1)}</td>
            <td class="index__title"><a href={w.href}>{w.title}</a></td>
            <td>{w.kind}</td>
            <td>{w.status ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>

<style>
  /* A photograph-led first composition. Typography identifies the maker; it does not replace the image. */
  .hero { margin-bottom: clamp(72px, 9vw, 140px); }
  .hero__heading { padding-bottom: clamp(16px, 2.3vw, 32px); }
  .hero__eyebrow { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; margin-bottom: clamp(14px, 2vw, 28px); }
  .hero__heading h1 {
    font-size: clamp(44px, 7.3vw, 106px);
    line-height: .94;
    font-weight: 790;
    font-stretch: 76%;
    letter-spacing: -.055em;
    margin: 0 0 14px;
  }
  .hero__heading h1 span { white-space: nowrap; }
  .hero__dot { color: var(--accent); }
  .hero__heading > p { font-size: clamp(17px, 1.8vw, 25px); line-height: 1.25; max-width: 650px; margin: 0; }
  .hero__composition { display: grid; gap: 0; align-items: stretch; }
  .hero__figure { margin: 0; min-width: 0; display: flex; flex-direction: column; }
  .hero__figure img {
    width: 100%; height: auto; max-height: min(76svh, 900px);
    object-fit: contain; object-position: left center;
    background: var(--paper-2);
  }
  .hero__figure figcaption { display: flex; align-items: center; justify-content: space-between; gap: 16px; border-top: 1px solid var(--ink); padding: 8px 0 0; min-height: 32px; }
  .hero__side {
    background: var(--accent); color: var(--ink);
    display: flex; flex-direction: column; justify-content: space-between;
    gap: 32px; padding: clamp(18px, 2.6vw, 40px);
  }
  .hero__side .label { color: var(--ink); }
  .hero__side-top { display: flex; justify-content: space-between; align-items: start; }
  .hero__side-top > span:last-child { font-size: clamp(32px, 5vw, 65px); line-height: .8; }
  .hero__side p { font-size: clamp(19px, 1.8vw, 27px); font-weight: 660; line-height: 1.2; font-stretch: 86%; max-width: 420px; }
  .hero__side nav { border-top: 2px solid var(--ink); }
  .hero__side nav a {
    display: flex; justify-content: space-between; align-items: baseline;
    gap: 12px; padding: 11px 0;
    border-bottom: 1px solid rgb(28 27 24 / .55);
    text-decoration: none; font-weight: 720; font-size: 19px;
  }
  .hero__side nav a:hover { color: var(--ink); text-decoration: underline; }
  @media (min-width: 1000px) {
    .hero__composition { grid-template-columns: minmax(0, 2.55fr) minmax(265px, 1fr); }
  }
  @media (max-width: 999px) {
    .hero__side { min-height: 215px; flex-direction: row; flex-wrap: wrap; align-items: end; }
    .hero__side-top { width: 100%; }
    .hero__side > div:last-child { width: 100%; }
    .hero__side p { max-width: 560px; }
  }

  /* Repeated editorial header motif makes the whole page feel designed, not just the hero. */
  .selected { margin-bottom: clamp(72px, 9vw, 140px); }
  .section-heading {
    display: grid; grid-template-columns: minmax(0, 1fr);
    margin-bottom: clamp(28px, 3.5vw, 48px);
    border-top: 2px solid var(--ink);
  }
  .section-heading__marker {
    display: flex; align-items: start; justify-content: space-between;
    gap: 16px; background: var(--accent); color: var(--ink);
    padding: 16px clamp(18px, 2.5vw, 36px);
  }
  .section-heading__marker .label { color: var(--ink); }
  .section-heading__marker > span:last-child { font-size: 42px; line-height: .7; }
  .section-heading__copy {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 8px 22px;
    padding: 18px clamp(18px, 2.5vw, 36px) 20px;
    border-bottom: 1px solid var(--ink);
  }
  .section-heading h2 {
    margin: 0; font-size: clamp(33px, 4.6vw, 68px);
    font-weight: 780; font-stretch: 78%; letter-spacing: -.045em;
  }
  .selected__grid {
    display: grid; grid-template-columns: minmax(0, 1fr);
    gap: clamp(36px, 5vw, 72px) var(--gap);
  }
  .selected__links { display: flex; flex-wrap: wrap; gap: 12px 28px; justify-content: flex-end; margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--rule); }
  .selected__links a { font-weight: 700; text-decoration: none; }
  .selected__links a:hover { text-decoration: underline; }
  @media (min-width: 760px) {
    .section-heading { grid-template-columns: minmax(155px, .34fr) minmax(0, 1.66fr); }
    .section-heading__marker { padding-block: 24px; }
    .selected__grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
    .selected__grid > :global(:first-child) { grid-column: 1 / -1; width: min(100%, 1160px); }
  }

  /* Same editorial header motif, quieter table. Neither section loses the design language. */
  .index { container-type: inline-size; }
  .section-heading--index .section-heading__marker { background: var(--ink); }
  .section-heading--index .section-heading__marker .label,
  .section-heading--index .section-heading__marker > span:last-child { color: var(--paper); }
  .section-heading--index .section-heading__copy { border-bottom: 5px solid var(--accent); }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  th, td { text-align: left; vertical-align: top; padding: 9px 16px 9px 0; line-height: 24px; }
  th { font-weight: 500; padding-block: 12px; line-height: 16px; box-shadow: inset 0 1px 0 var(--rule); }
  td { box-shadow: inset 0 1px 0 var(--rule-soft); }
  tbody tr:first-child td { box-shadow: inset 0 1px 0 var(--rule); }
  tbody tr:last-child td { box-shadow: inset 0 1px 0 var(--rule-soft), 0 1px 0 var(--rule); }
  th:nth-child(1) { width: 48px; }
  th:nth-child(2) { width: 48%; }
  .index__title { font-size: clamp(16px, 1.4vw, 20px); font-weight: 650; font-stretch: 88%; }
  .index__title a { text-decoration: none; }
  .index__title a:hover { text-decoration: underline; }
  @media (max-width: 759px) {
    td:nth-child(4), th:nth-child(4) { display: none; }
    .hero__heading h1 { font-size: clamp(38px, 10vw, 72px); }
  }
  @media (min-width: 760px) {
    th:nth-child(1) { width: 80px; }
    th:nth-child(2) { width: 40%; }
    th:nth-child(3) { width: 30%; }
  }
</style>
