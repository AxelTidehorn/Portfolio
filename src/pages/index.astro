---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getAllWork } from '../lib/work';

const all = await getAllWork();
const features = [
  ...all.filter((item) => item.featured && item.kind === 'Photography'),
  ...all.filter((item) => item.featured && item.kind !== 'Photography'),
];
const pageSize = 5;
const indexPages = Array.from(
  { length: Math.ceil(all.length / pageSize) },
  (_, index) => all.slice(index * pageSize, (index + 1) * pageSize),
);
const total = 1 + features.length + indexPages.length + 1;
const pad = (n: number) => String(n).padStart(2, '0');
const nextAfterIntro = features.length ? 'feature-1' : indexPages.length ? 'index-1' : 'explore';
const nextAfterFeatures = indexPages.length ? 'index-1' : 'explore';
const hero = site.hero.image;
---
<Base image={hero} sheet="Index">
  <section class="stage stage--intro wrap" id="intro" aria-labelledby="home-title">
    <div class="stage__layout intro-layout">
      <figure class="stage__figure">
        <div class="stage__image">
          <Image
            src={hero}
            alt={site.hero.alt}
            widths={[800, 1200, 1800, 2400, 3000]}
            sizes="(min-width: 760px) 73vw, 100vw"
            quality={86}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="image-caption">
          <span class="label">Photograph / 001</span>
          {site.hero.placeholder && <span class="badge">Placeholder</span>}
        </figcaption>
      </figure>
      <div class="intro-copy">
        <div class="intro-copy__top">
          <span class="label">Independent practice / Sweden</span>
          <span class="intro-copy__mark" aria-hidden="true">↗</span>
        </div>
        <div class="intro-copy__bottom">
          <h1 id="home-title">Axel<br />Tidehorn<span>.</span></h1>
          <p>Photography, product design, engineering and experiments.</p>
          <a class="chapter-link" href="/photography/">Explore photography <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
    <div class="stage__foot">
      <span class="label">01 / {pad(total)} · Introduction</span>
      <a class="stage__next" href={`#${nextAfterIntro}`}>Next composition <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  {features.map((work, i) => {
    const nextId = i + 1 < features.length ? `feature-${i + 2}` : nextAfterFeatures;
    const isPhoto = work.kind === 'Photography';
    const inverse = i % 2 === 1;
    return (
      <section
        class:list={['stage', 'stage--feature', 'wrap', { 'stage--inverse': inverse, 'stage--photo': isPhoto }]}
        id={`feature-${i + 1}`}
        aria-labelledby={`feature-title-${i + 1}`}
      >
        <div class="stage__layout feature-layout">
          <figure class="stage__figure">
            <div class="stage__image">
              <Image
                src={work.cover.src}
                alt={work.cover.alt}
                widths={[480, 800, 1200, 1600, 2000]}
                sizes="(min-width: 760px) 70vw, 100vw"
                quality={86}
                loading="lazy"
              />
            </div>
            <figcaption class="image-caption">
              <span class="label">{isPhoto ? 'Photography' : 'Project'} / {pad(i + 1)}</span>
              {work.placeholder && <span class="badge">Placeholder</span>}
            </figcaption>
          </figure>
          <div class="feature-copy">
            <div class="feature-copy__top">
              <span class="label">{isPhoto ? 'Photographic work' : 'Making and experimenting'}</span>
              <span class="feature-copy__index">{pad(i + 1)}</span>
            </div>
            <div class="feature-copy__bottom">
              <h2 id={`feature-title-${i + 1}`}>{work.title}</h2>
              <p>{work.summary}</p>
              <a class="chapter-link" href={work.href}>View {isPhoto ? 'photo series' : 'project'} <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
        <div class="stage__foot">
          <span class="label">{pad(i + 2)} / {pad(total)} · {isPhoto ? 'Photography' : 'Selected project'}</span>
          <a class="stage__next" href={`#${nextId}`}>Next composition <span aria-hidden="true">↓</span></a>
        </div>
      </section>
    );
  })}

  {indexPages.map((page, pageIndex) => {
    const nextId = pageIndex + 1 < indexPages.length ? `index-${pageIndex + 2}` : 'explore';
    return (
      <section class="stage stage--index wrap" id={`index-${pageIndex + 1}`} aria-labelledby={`index-title-${pageIndex + 1}`}>
        <div class="stage__layout index-layout">
          <header class="index-heading">
            <div class="index-heading__label">
              <span class="label">Directory / {pad(pageIndex + 1)}</span>
              <span aria-hidden="true">↗</span>
            </div>
            <div class="index-heading__title">
              <h2 id={`index-title-${pageIndex + 1}`}>Index of work</h2>
              <span class="label">{pad(all.length)} total entries</span>
            </div>
          </header>
          <ol class="index-list" start={pageIndex * pageSize + 1} style={`--entries: ${page.length}`}>
            {page.map((work, itemIndex) => (
              <li>
                <a href={work.href}>
                  <span class="index-list__number">{pad(pageIndex * pageSize + itemIndex + 1)}</span>
                  <strong>{work.title}</strong>
                  <span class="index-list__kind">{work.kind}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="stage__foot">
          <span class="label">{pad(2 + features.length + pageIndex)} / {pad(total)} · Directory</span>
          <a class="stage__next" href={`#${nextId}`}>Next composition <span aria-hidden="true">↓</span></a>
        </div>
      </section>
    );
  })}

  <section class="stage stage--closing wrap" id="explore" aria-labelledby="explore-title">
    <div class="stage__layout closing-layout">
      <div class="closing-layout__top">
        <span class="label">Axel Tidehorn / Index</span>
        <span class="label">Photography first. Everything else alongside it.</span>
      </div>
      <div class="closing-layout__links">
        <h2 id="explore-title">Explore.</h2>
        <a href="/photography/">Photography <span aria-hidden="true">↗</span></a>
        <a href="/projects/">Projects <span aria-hidden="true">↗</span></a>
        <a href="/about/">About <span aria-hidden="true">↗</span></a>
        <a href="/gear/">Photo gear <span aria-hidden="true">↗</span></a>
      </div>
      <div class="closing-layout__bottom">
        <span class="label">© {site.name}</span>
        <span class="label">{site.url.replace('https://', '')}</span>
      </div>
    </div>
    <div class="stage__foot">
      <span class="label">{pad(total)} / {pad(total)} · End</span>
      <a class="stage__next" href="#intro">Back to first composition <span aria-hidden="true">↑</span></a>
    </div>
  </section>
</Base>

<style>
  /* Every stage is one complete, viewport-sized composition.
     Height is bounded on normal devices, not inferred from a long content grid. */
  .stage {
    height: calc(100svh - var(--presentation-header-height));
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0;
    padding-top: clamp(12px, 1.8svh, 20px);
    padding-bottom: 8px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .stage__layout { min-height: 0; overflow: hidden; }
  .stage__foot {
    min-height: 38px;
    display: flex; justify-content: space-between; align-items: center;
    gap: 16px; border-top: 1px solid var(--ink); padding: 9px 0 2px;
  }
  .stage__next { font: 500 12px/1.3 var(--font-mono); text-decoration: none; }
  .stage__next:hover { text-decoration: underline; }
  .stage__figure { display: grid; grid-template-rows: minmax(0, 1fr) auto; min-width: 0; min-height: 0; margin: 0; }
  .stage__image { display: grid; place-items: center; min-height: 0; min-width: 0; overflow: hidden; background: var(--paper-2); }
  .stage__image img { display: block; height: 100%; width: 100%; object-fit: contain; object-position: center; }
  .image-caption { min-height: 30px; display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 6px 0; }
  .image-caption .badge { font-size: 9px; }
  .intro-layout, .feature-layout { display: grid; grid-template-columns: minmax(0, 2.1fr) minmax(250px, .85fr); gap: clamp(10px, 1.8vw, 28px); }

  .intro-copy, .feature-copy { min-height: 0; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(20px, 2.6vw, 44px); }
  .intro-copy { background: var(--accent); color: var(--ink); }
  .intro-copy .label { color: var(--ink); }
  .intro-copy__top, .feature-copy__top { display: flex; justify-content: space-between; align-items: start; gap: 16px; }
  .intro-copy__mark { font-size: clamp(34px, 4vw, 64px); line-height: .8; }
  .intro-copy h1 { font-size: clamp(44px, 5.8vw, 86px); font-stretch: 72%; font-weight: 800; letter-spacing: -.058em; line-height: .92; margin: 0 0 clamp(20px, 4svh, 40px); }
  .intro-copy h1 span { color: var(--paper); }
  .intro-copy p { font-size: clamp(18px, 1.65vw, 23px); font-weight: 620; line-height: 1.23; max-width: 340px; margin: 0 0 clamp(24px, 4svh, 50px); }
  .chapter-link { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; border-top: 2px solid currentColor; padding: 12px 0 0; text-decoration: none; font-size: clamp(15px, 1.4vw, 19px); font-weight: 720; }
  .chapter-link:hover { color: inherit; text-decoration: underline; }

  /* The projects have their own layouts rather than one uncontrolled grid. */
  .feature-copy { background: var(--paper-2); }
  .feature-copy h2 { font-size: clamp(31px, 4.3vw, 66px); line-height: .96; font-stretch: 77%; letter-spacing: -.047em; margin: 0 0 22px; overflow-wrap: anywhere; }
  .feature-copy p { font-size: clamp(17px, 1.6vw, 23px); line-height: 1.26; max-width: 390px; margin: 0 0 clamp(22px, 4svh, 46px); }
  .feature-copy__index { font-size: clamp(42px, 6vw, 90px); line-height: .75; font-weight: 750; font-stretch: 70%; color: var(--accent-ink); }
  .stage--inverse .feature-layout { grid-template-columns: minmax(250px, .85fr) minmax(0, 2.1fr); }
  .stage--inverse .stage__figure { order: 2; }
  .stage--inverse .feature-copy { order: 1; background: var(--ink); color: var(--paper); }
  .stage--inverse .feature-copy .label { color: var(--paper); }
  .stage--inverse .feature-copy__index { color: var(--accent); }
  .stage--feature:not(.stage--inverse) .feature-copy { border-top: clamp(8px, 1.2vw, 18px) solid var(--accent); }
  .stage--photo .feature-copy { background: var(--accent); border-top: 0 !important; }
  .stage--photo .feature-copy .label { color: var(--ink); }

  /* Five compact directory entries at most per screen, no variable-height list. */
  .index-layout { display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .index-heading { display: grid; grid-template-columns: minmax(175px, .5fr) minmax(0, 1.5fr); border-top: 2px solid var(--ink); }
  .index-heading__label { display: flex; justify-content: space-between; align-items: start; gap: 10px; padding: clamp(16px, 2vw, 32px); background: var(--accent); }
  .index-heading__label .label { color: var(--ink); }
  .index-heading__label > span:last-child { font-size: clamp(30px, 4vw, 56px); line-height: .75; }
  .index-heading__title { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; padding: clamp(16px, 2vw, 32px); border-bottom: 2px solid var(--ink); flex-wrap: wrap; }
  .index-heading h2 { font-size: clamp(30px, 4.5vw, 67px); margin: 0; }
  .index-list { padding: clamp(12px, 2svh, 25px) 0; margin: 0; display: grid; grid-template-rows: repeat(var(--entries, 5), minmax(0, 1fr)); list-style: none; min-height: 0; }
  .index-list li { display: flex; align-items: center; min-height: 0; border-bottom: 1px solid var(--rule-soft); }
  .index-list li:first-child { border-top: 1px solid var(--rule-soft); }
  .index-list a { display: grid; grid-template-columns: 62px minmax(0, 1.2fr) minmax(0, .8fr) 20px; align-items: center; width: 100%; gap: 12px; padding: 8px 0; text-decoration: none; }
  .index-list a:hover strong { color: var(--accent-ink); }
  .index-list__number { font: 500 12px var(--font-mono); }
  .index-list strong { font-size: clamp(19px, 2.4vw, 35px); line-height: 1.05; font-weight: 750; font-stretch: 80%; overflow-wrap: anywhere; }
  .index-list__kind { font: 400 clamp(10px, .95vw, 13px)/1.3 var(--font-mono); color: var(--ink-2); }

  .closing-layout { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; padding: clamp(20px, 3.5vw, 52px); background: var(--accent); }
  .closing-layout .label { color: var(--ink); }
  .closing-layout__top, .closing-layout__bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .closing-layout__links { align-content: center; display: grid; width: min(100%, 950px); margin-inline: auto; }
  .closing-layout h2 { font-size: clamp(36px, 5vw, 70px); margin: 0 0 18px; }
  .closing-layout__links a { display: flex; justify-content: space-between; gap: 12px; border-top: 2px solid var(--ink); padding: clamp(8px, 1.2svh, 15px) 0; font-size: clamp(24px, 3vw, 48px); font-weight: 770; font-stretch: 75%; line-height: 1.08; text-decoration: none; }
  .closing-layout__links a:hover { color: var(--ink); text-decoration: underline; }
  .closing-layout__links a:last-child { border-bottom: 2px solid var(--ink); }

  /* Compress and rearrange compositions rather than letting a slide overflow. */
  @media (max-width: 850px) {
    .intro-layout, .feature-layout { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1.5fr) minmax(0, .85fr); gap: 10px; }
    .stage--inverse .feature-layout { grid-template-columns: minmax(0, 1fr); }
    .stage--inverse .stage__figure, .stage--inverse .feature-copy { order: initial; }
    .intro-copy, .feature-copy { padding: clamp(15px, 3vw, 28px); }
    .intro-copy h1 { font-size: clamp(32px, 6.5vw, 58px); margin-bottom: 10px; }
    .intro-copy h1 br { display: none; }
    .intro-copy p { margin-bottom: 12px; }
    .feature-copy h2 { font-size: clamp(26px, 5vw, 47px); margin-bottom: 8px; }
    .feature-copy p { font-size: 16px; margin-bottom: 12px; }
    .feature-copy__index { font-size: 40px; }
    .chapter-link { padding-top: 8px; font-size: 15px; }
    .index-heading { grid-template-columns: minmax(140px, .55fr) minmax(0, 1.45fr); }
    .index-list a { grid-template-columns: 42px minmax(0, 1fr) 20px; }
    .index-list__kind { display: none; }
  }
  @media (max-width: 520px) {
    .stage { padding-top: 10px; }
    .stage__foot { min-height: 35px; }
    .intro-layout, .feature-layout { grid-template-rows: minmax(0, 1.55fr) minmax(0, .95fr); }
    .intro-copy h1 { font-size: clamp(31px, 8vw, 42px); line-height: 1; margin-bottom: 10px; }
    .intro-copy p { font-size: 16px; margin-bottom: 10px; }
    .intro-copy__mark { font-size: 32px; }
    .feature-copy__top .label { font-size: 10px; }
    .feature-copy__index { font-size: 35px; }
    .feature-copy h2 { font-size: 30px; margin-bottom: 7px; }
    .feature-copy p { font-size: 14px; line-height: 1.22; margin-bottom: 10px; }
    .chapter-link { font-size: 13px; }
    .index-heading { grid-template-columns: 1fr; }
    .index-heading__label { padding: 10px 14px; }
    .index-heading__label > span:last-child { font-size: 26px; }
    .index-heading__title { padding: 13px 14px; }
    .index-heading h2 { font-size: 31px; }
    .index-list strong { font-size: clamp(18px, 5.1vw, 23px); }
    .index-list a { grid-template-columns: 32px minmax(0, 1fr) 18px; gap: 6px; }
    .closing-layout { padding: 20px; }
    .closing-layout__top .label:last-child { display: none; }
    .closing-layout__links a { font-size: clamp(22px, 6vw, 31px); }
  }
  /* When browser content area is too short to show one whole composition,
     preserve all content and allow normal scrolling instead of clipping. */
  @media (max-height: 620px) {
    .stage { height: auto; min-height: 620px; }
    .intro-layout, .feature-layout { min-height: 510px; }
    .index-layout { min-height: 510px; }
    .closing-layout { min-height: 510px; }
  }
</style>
