---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../data/site';
import { getAllWork } from '../lib/work';

const all = await getAllWork();
// Interleave featured photography and projects so neither dominates.
const featuredPhoto = all.filter((w) => w.featured && w.kind === 'Photography');
const featuredOther = all.filter((w) => w.featured && w.kind !== 'Photography');
const selected = Array.from({ length: Math.max(featuredPhoto.length, featuredOther.length) })
  .flatMap((_, i) => [featuredPhoto[i], featuredOther[i]])
  .filter(Boolean);
const counts = {
  '/photography/': all.filter((w) => w.kind === 'Photography').length,
  '/projects/': all.filter((w) => w.kind !== 'Photography').length,
};
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base image={site.hero.image} sheet="Index">
  <section class="hero wrap">
    <figure class="hero__fig">
      <Image
        src={site.hero.image}
        alt={site.hero.alt}
        widths={[800, 1200, 1800, 2400, 3000]}
        sizes="(min-width: 1100px) 70vw, 100vw"
        quality={86}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <aside class="hero__side">
      <div class="hero__fighead pen">
        <span class="label">Fig. 01</span>
        {site.hero.placeholder && <span class="badge">Placeholder</span>}
      </div>
      <p class="intro">{site.intro}</p>
      <ul class="jump">
        {site.nav.slice(0, 2).map((n) => (
          <li class="pen">
            <a href={n.href}>
              <span class="label">{n.code}</span>
              <span class="jump__name">{n.label}</span>
              <span class="label">{pad(counts[n.href as keyof typeof counts])} →</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </section>

  <section class="selected wrap" aria-labelledby="sel">
    <header class="sec-head pen">
      <span class="label">§ 01</span>
      <h2 id="sel">Selected work</h2>
      <span class="label">{pad(selected.length)} items</span>
    </header>
    <div class="selected__grid">
      {selected.map((w, i) => (
        <WorkCard
          href={w.href}
          no={pad(i + 1)}
          title={w.title}
          kind={w.kind}
          summary={w.summary}
          cover={w.cover}
          placeholder={w.placeholder}
          sizes={i % 4 === 0 || i % 4 === 3 ? '(min-width: 760px) 58vw, 100vw' : '(min-width: 760px) 42vw, 100vw'}
        />
      ))}
    </div>
  </section>

  <section class="index wrap" aria-labelledby="idx">
    <header class="sec-head pen">
      <span class="label">§ 02</span>
      <h2 id="idx">Index of work</h2>
    </header>
    <table class="sheet">
      <thead>
        <tr><th scope="col" class="label">No.</th><th scope="col" class="label">Title</th><th scope="col" class="label">Type</th><th scope="col" class="label">Status</th></tr>
      </thead>
      <tbody>
        {all.map((w, i) => (
          <tr>
            <td class="label">{pad(i + 1)}</td>
            <td class="index__title"><a href={w.href}>{w.title}</a></td>
            <td>{w.kind}</td>
            <td>{w.status ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>

<style>
  .hero { display: grid; gap: 1.25rem; margin-bottom: var(--space); }
  /* Crop marks sit outside the photograph's corners, never on it. */
  .hero__fig { margin: 0; position: relative; width: fit-content; max-width: 100%; }
  .hero__fig::before, .hero__fig::after {
    content: ''; position: absolute; width: 14px; height: 14px; border: 0 solid var(--rule);
    filter: url(#pen);
  }
  .hero__fig::before { top: -9px; left: -9px; border-width: 1px 0 0 1px; }
  .hero__fig::after { bottom: -9px; right: -9px; border-width: 0 1px 1px 0; }
  .hero__fig img { max-height: 78vh; width: auto; }

  .hero__side { display: flex; flex-direction: column; }
  .hero__fighead { --pen: 2px 0 0 0; display: flex; justify-content: space-between; align-items: center; padding-top: 0.6rem; }
  .intro {
    font-size: clamp(1.35rem, 2.1vw, 1.8rem);
    font-weight: 460; font-stretch: 88%;
    line-height: 1.18; letter-spacing: -0.012em;
    margin: 1rem 0 1.5rem; max-width: 26rem;
  }
  .jump { list-style: none; margin: 0; padding: 0; }
  .jump li { --pen: 1px 0 0 0; }
  .jump li:last-child { --pen: 1px 0 1px 0; }
  .jump a { display: grid; grid-template-columns: 2rem 1fr auto; align-items: baseline; padding: 0.55rem 0; text-decoration: none; }
  .jump__name { font-size: 1.3rem; font-weight: 620; font-stretch: 85%; }
  @media (min-width: 1100px) {
    .hero { grid-template-columns: minmax(0, 1fr) 19rem; gap: 2rem; align-items: stretch; }
    .jump { margin-top: auto; }
  }

  .selected { margin-bottom: var(--space); }
  .selected__grid { display: grid; gap: 2rem 1.25rem; }
  @media (min-width: 760px) {
    /* Asymmetric rhythm: alternating 7/5 and 5/7 columns. */
    .selected__grid { grid-template-columns: repeat(12, 1fr); align-items: start; }
    .selected__grid > :global(*) { grid-column: span 5; }
    .selected__grid > :global(:nth-child(4n + 1)),
    .selected__grid > :global(:nth-child(4n + 4)) { grid-column: span 7; }
  }

  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-weight: 500; padding: 0.5rem 0.75rem 0.45rem 0; border-bottom: 1.5px solid var(--rule); }
  td { padding: 0.55rem 0.75rem 0.55rem 0; vertical-align: baseline; border-bottom: 1px solid var(--rule-soft); }
  td:first-child, th:first-child { width: 3.5rem; padding-left: 0.5rem; }
  .index__title { font-size: 1.15rem; font-weight: 600; font-stretch: 88%; }
  .index__title a { text-decoration: none; }
  @media (max-width: 599px) { td:nth-child(4), th:nth-child(4) { display: none; } }
</style>
