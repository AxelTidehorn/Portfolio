---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../data/site';
import { getAllWork } from '../lib/work';

const all = await getAllWork();
// Photography leads the selection; other disciplines remain immediately discoverable.
const featuredPhoto = all.filter((w) => w.featured && w.kind === 'Photography');
const featuredOther = all.filter((w) => w.featured && w.kind !== 'Photography');
const selected = [...featuredPhoto, ...featuredOther];
const counts = {
  '/photography/': all.filter((w) => w.kind === 'Photography').length,
  '/projects/': all.filter((w) => w.kind !== 'Photography').length,
};
const pad = (n: number) => String(n).padStart(2, '0');
const hero = site.hero.image;
---
<Base image={hero} sheet="Index">
  <section class="hero wrap">
    <figure class="hero__fig snap" style={`--r: ${hero.height / hero.width}; --snap-max: 78vh`}>
      <div>
        <span class="hero__img">
          <Image
            src={hero}
            alt={site.hero.alt}
            widths={[800, 1200, 1800, 2400, 3000]}
            sizes="(min-width: 1100px) 70vw, 100vw"
            quality={86}
            loading="eager"
            fetchpriority="high"
          />
        </span>
      </div>
    </figure>
    <aside class="hero__side">
      <div class="hero__fighead rule">
        <span class="label">Fig. 01</span>
        {site.hero.placeholder && <span class="badge">Placeholder</span>}
      </div>
      <p class="intro">{site.intro}</p>
      <ul class="jump">
        {site.nav.slice(0, 2).map((n) => (
          <li class="rule">
            <a href={n.href}>
              <span class="label">{n.code}</span>
              <span class="jump__name">{n.label}</span>
              <span class="label">{pad(counts[n.href as keyof typeof counts])} →</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </section>

  <section class="selected wrap" aria-labelledby="sel">
    <header class="sec-head rule">
      <span class="label">01 / Portfolio</span>
      <h2 id="sel">Selected work</h2>
      <span class="label">{pad(selected.length)} items</span>
    </header>
    <div class="selected__grid">
      {selected.map((w, i) => (
        <WorkCard
          href={w.href}
          no={pad(i + 1)}
          title={w.title}
          kind={w.kind}
          summary={w.summary}
          cover={w.cover}
          placeholder={w.placeholder}
          sizes={i % 4 === 0 || i % 4 === 3 ? '(min-width: 760px) 58vw, 100vw' : '(min-width: 760px) 42vw, 100vw'}
        />
      ))}
    </div>
  </section>

  <section class="index wrap" aria-labelledby="idx">
    <header class="sec-head rule">
      <span class="label">02 / Index</span>
      <h2 id="idx">Index of work</h2>
    </header>
    <table>
      <thead>
        <tr><th scope="col" class="label">No.</th><th scope="col" class="label">Title</th><th scope="col" class="label">Type</th><th scope="col" class="label">Status</th></tr>
      </thead>
      <tbody>
        {all.map((w, i) => (
          <tr>
            <td class="label">{pad(i + 1)}</td>
            <td class="index__title"><a href={w.href}>{w.title}</a></td>
            <td>{w.kind}</td>
            <td>{w.status ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>

<style>
  .hero { display: grid; gap: 24px; margin-bottom: var(--space); }
  .hero__fig { margin: 0; }
  .hero__img { position: relative; display: inline-block; vertical-align: top; max-width: 100%; }
  .hero__img img { max-height: 78vh; width: auto; }

  .hero__side { display: flex; flex-direction: column; }
  .hero__fighead { --rt: var(--w-outline); display: flex; justify-content: space-between; align-items: center; padding-top: 8px; }
  .intro {
    font-size: 24px; line-height: 32px;
    font-weight: 460; font-stretch: 88%; letter-spacing: -0.012em;
    margin: 16px 0 24px; max-width: 400px;
  }
  .jump { list-style: none; margin: 0; padding: 0; }
  .jump li { --rt: var(--w-div); }
  .jump li:last-child { --rb: var(--w-div); }
  .jump a { display: grid; grid-template-columns: 40px 1fr auto; align-items: baseline; padding: 8px 0; text-decoration: none; }
  .jump__name { font-size: 20px; line-height: 24px; font-weight: 620; font-stretch: 85%; }
  @media (min-width: 1100px) {
    .hero { grid-template-columns: minmax(0, 1fr) 320px; gap: var(--gap); align-items: stretch; }
    .intro { font-size: 28px; }
    .jump { margin-top: auto; }
  }

  .selected { margin-bottom: var(--space); }
  .selected__grid {
    display: grid;
    gap: clamp(28px, 3vw, 48px) var(--gap);
  }
  @media (min-width: 760px) {
    .selected__grid { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); }
    .selected__grid > :global(:nth-child(4n + 3)) { grid-column: 2; }
  }

  /* Rows are exactly 40px; lines are inset shadows on each cell's top edge (no layout shift). */
  /* Table columns use cqw: percentages inside round() are ignored by the table layout algorithm. */
  .index { container-type: inline-size; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  /* Top-aligned 24px lines: baseline alignment between mono and sans cells would grow rows past 40px. */
  th, td { text-align: left; vertical-align: top; padding: 8px 16px 8px 0; line-height: 24px; }
  th { font-weight: 500; padding-block: 12px; line-height: 16px; box-shadow: inset 0 1px 0 var(--rule); }
  td { box-shadow: inset 0 1px 0 var(--rule-soft); }
  tbody tr:first-child td { box-shadow: inset 0 1px 0 var(--rule); }
  tbody tr:last-child td { box-shadow: inset 0 1px 0 var(--rule-soft), 0 1px 0 var(--rule); }
  th:nth-child(1) { width: 48px; }
  th:nth-child(2) { width: 48%; }
  .index__title { font-size: 18px; font-weight: 600; font-stretch: 88%; }
  .index__title a { text-decoration: none; }
  @media (max-width: 759px) { td:nth-child(4), th:nth-child(4) { display: none; } }
  @media (min-width: 760px) {
    th:nth-child(1) { width: 80px; }
    th:nth-child(2) { width: 40%; }
    th:nth-child(3) { width: 30%; }
  }
</style>
