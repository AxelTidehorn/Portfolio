---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../data/site';
import { getAllWork } from '../lib/work';

const all = await getAllWork();
// Photography leads the selection; other disciplines remain immediately discoverable.
const featuredPhoto = all.filter((w) => w.featured && w.kind === 'Photography');
const featuredOther = all.filter((w) => w.featured && w.kind !== 'Photography');
const selected = [...featuredPhoto, ...featuredOther];
const counts = {
  '/photography/': all.filter((w) => w.kind === 'Photography').length,
  '/projects/': all.filter((w) => w.kind !== 'Photography').length,
};
const pad = (n: number) => String(n).padStart(2, '0');
const hero = site.hero.image;
---
<Base image={hero} sheet="Index">\n  <div class="home-story">
  <section id="intro" class="opening wrap story-section" aria-labelledby="opening-title">
    <div class="opening__eyebrow">
      <span class="label">Independent practice / Sweden</span>
      <span class="label">Photography · Objects · Experiments</span>
    </div>
    <h1 id="opening-title" class="opening__title">
      <span>Seeing</span>
      <span class="opening__second">making<span class="opening__dot">.</span></span>
    </h1>
    <div class="opening__bottom">
      <p>Photography, design and the pleasure of figuring things out.</p>
      <a class="opening__next label" href="#photograph">Explore ↓</a>
    </div>
  </section>

  <section id="photograph" class="hero wrap story-section" aria-label="Featured photography">
    <figure class="hero__fig">
      <Image
        src={hero}
        alt={site.hero.alt}
        widths={[800, 1200, 1800, 2400, 3000]}
        sizes="(min-width: 1100px) 72vw, 100vw"
        quality={86}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="hero__caption">
        <span class="label">01 / Featured photograph</span>
        {site.hero.placeholder && <span class="badge">Placeholder</span>}
      </figcaption>
    </figure>
    <aside class="hero__panel">
      <div class="hero__panel-top">
        <span class="label">AT / 001</span>
        <span class="hero__glyph" aria-hidden="true">↗</span>
      </div>
      <div class="hero__panel-bottom">
        <p>{site.intro}</p>
        <ul class="hero__links">
          {site.nav.slice(0, 2).map((n) => (
            <li>
              <a href={n.href}>
                <span>{n.label}</span>
                <span class="hero__link-count">{pad(counts[n.href as keyof typeof counts])} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </section>

  <section id="work" class="selected wrap story-section" aria-labelledby="sel">
    <header class="sec-head rule">
      <span class="label">02 / Selection</span>
      <h2 id="sel">Selected work</h2>
      <span class="label">{pad(selected.length)} items</span>
    </header>
    <div class="selected__grid">
      {selected.map((w, i) => (
        <WorkCard
          href={w.href}
          no={pad(i + 1)}
          title={w.title}
          kind={w.kind}
          summary={w.summary}
          cover={w.cover}
          placeholder={w.placeholder}
          sizes={i % 4 === 0 || i % 4 === 3 ? '(min-width: 760px) 58vw, 100vw' : '(min-width: 760px) 42vw, 100vw'}
        />
      ))}
    </div>
  </section>

  <section id="directory" class="index wrap story-section" aria-labelledby="idx">
    <header class="sec-head rule">
      <span class="label">03 / Index</span>
      <h2 id="idx">Index of work</h2>
    </header>
    <table>
      <thead>
        <tr><th scope="col" class="label">No.</th><th scope="col" class="label">Title</th><th scope="col" class="label">Type</th><th scope="col" class="label">Status</th></tr>
      </thead>
      <tbody>
        {all.map((w, i) => (
          <tr>
            <td class="label">{pad(i + 1)}</td>
            <td class="index__title"><a href={w.href}>{w.title}</a></td>
            <td>{w.kind}</td>
            <td>{w.status ?? '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
  </div>\n</Base>

<style>
  /* Poster-like first impression: one monumental typographic move, then the photograph. */
  .opening { margin-bottom: clamp(18px, 2.5vw, 36px); }
  .opening__eyebrow { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-bottom: 14px; border-bottom: 1px solid var(--rule-soft); }
  .opening__title {
    font-weight: 850;
    font-stretch: 65%;
    font-size: clamp(78px, 13.7vw, 225px);
    line-height: 0.78;
    letter-spacing: -0.065em;
    text-transform: uppercase;
    margin: 20px 0 24px;
  }
  .opening__title > span { display: block; }
  .opening__second { padding-left: clamp(8px, 8vw, 142px); }
  .opening__dot { color: var(--accent); }
  .opening__bottom {
    display: flex; align-items: end; justify-content: space-between;
    gap: 20px; border-top: 2px solid var(--ink); padding-top: 13px;
  }
  .opening__bottom p { max-width: 440px; margin: 0; font-size: clamp(18px, 2vw, 26px); line-height: 1.2; font-weight: 550; font-stretch: 86%; }
  .opening__edition { text-align: right; }

  .hero {
    display: grid;
    gap: 0;
    margin-bottom: calc(var(--space) * 1.2);
    align-items: stretch;
  }
  .hero__fig { min-width: 0; margin: 0; display: flex; flex-direction: column; }
  .hero__fig img { width: 100%; height: auto; max-height: min(68vw, 760px); object-fit: contain; object-position: left top; }
  .hero__caption { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; border-top: 1px solid var(--rule); padding: 8px 0; }
  .hero__panel {
    background: var(--accent);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(18px, 2.6vw, 40px);
    min-width: 0;
  }
  .hero__panel .label { color: var(--ink); }
  .hero__panel-top { display: flex; justify-content: space-between; align-items: start; }
  .hero__glyph { font-size: clamp(68px, 9vw, 148px); font-weight: 350; line-height: 0.72; }
  .hero__panel-bottom p { font-size: clamp(22px, 2.3vw, 35px); font-weight: 730; font-stretch: 78%; line-height: 1.08; letter-spacing: -0.03em; margin: 40px 0; }
  .hero__links { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .hero__links li { border-bottom: 1px solid rgb(28 27 24 / 0.5); }
  .hero__links a {
    display: flex; justify-content: space-between; gap: 12px; padding: 12px 0;
    text-decoration: none; font-size: clamp(18px, 1.5vw, 22px); font-weight: 700; font-stretch: 78%;
  }
  .hero__links a:hover { color: var(--ink); text-decoration: underline; }
  .hero__link-count { font: 500 13px/1.4 var(--font-mono); white-space: nowrap; }

  .selected { margin-bottom: var(--space); }
  .selected .sec-head { --rt: 3px; gap: 20px; padding-top: 18px; margin-bottom: 24px; }
  .selected .sec-head h2 { font-size: clamp(46px, 7.7vw, 118px); font-weight: 820; font-stretch: 68%; letter-spacing: -0.055em; }
  .selected__grid { display: grid; gap: clamp(28px, 3vw, 48px) var(--gap); }
  .selected__grid > :global(:first-child) { grid-column: 1 / -1; }
  @media (min-width: 760px) {
    .selected__grid { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); }
    .selected__grid > :global(:first-child) { width: min(82%, 1180px); }
  }
  .index { container-type: inline-size; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; }
  th, td { text-align: left; vertical-align: top; padding: 8px 16px 8px 0; line-height: 24px; }
  th { font-weight: 500; padding-block: 12px; line-height: 16px; box-shadow: inset 0 1px 0 var(--rule); }
  td { box-shadow: inset 0 1px 0 var(--rule-soft); }
  tbody tr:first-child td { box-shadow: inset 0 1px 0 var(--rule); }
  tbody tr:last-child td { box-shadow: inset 0 1px 0 var(--rule-soft), 0 1px 0 var(--rule); }
  th:nth-child(1) { width: 48px; }
  th:nth-child(2) { width: 48%; }
  .index__title { font-size: 18px; font-weight: 600; font-stretch: 88%; }
  .index__title a { text-decoration: none; }
  @media (max-width: 759px) { td:nth-child(4), th:nth-child(4) { display: none; } }
  @media (min-width: 760px) {
    th:nth-child(1) { width: 80px; }
    th:nth-child(2) { width: 40%; }
    th:nth-child(3) { width: 30%; }
  }
  @media (min-width: 1100px) {
    .hero { grid-template-columns: minmax(0, 2.15fr) minmax(280px, 0.85fr); }
  }
  @media (max-width: 1099px) {
    .hero__panel { min-height: 280px; }
    .hero__panel-bottom p { margin: 16px 0 24px; max-width: 640px; }
    .hero__glyph { font-size: 76px; }
  }
  @media (max-width: 600px) {
    .opening__title { font-size: clamp(53px, 14vw, 84px); margin: 18px 0; letter-spacing: -0.06em; }
    .opening__second { padding-left: 4vw; }
    .opening__bottom { align-items: start; }
    .opening__bottom p { font-size: 17px; max-width: 240px; }
    .hero__panel { min-height: 300px; }
    .selected .sec-head { flex-wrap: wrap; gap: 8px 14px; }
    .selected .sec-head h2 { order: 2; flex-basis: 100%; }
  }

  /* Home page is an intentional sequence of compositions.
     Snap applies only to wide pointer-led layouts; tall sections can still be
     scrolled through without trapping content. Natural flow elsewhere. */
  :global(html:has(.home-story)) { scroll-padding-top: 0; }
  .home-story { overflow: clip; }
  .story-section { scroll-snap-align: start; scroll-snap-stop: always; }
  .opening {
    background: var(--accent);
    min-height: calc(100svh - clamp(90px, 10vw, 142px));
    padding: clamp(20px, 3vw, 48px);
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .opening__eyebrow { border-bottom: 2px solid var(--ink); }
  .opening__title {
    font-size: clamp(72px, 14.8vw, 245px);
    font-stretch: 60%; line-height: .79; letter-spacing: -.075em;
    overflow-wrap: normal;
    margin: 40px 0;
  }
  .opening__title .opening__second { padding-left: 0; }
  .opening__dot { color: var(--paper); }
  .opening__bottom { border-top: 2px solid var(--ink); padding-top: 16px; }
  .opening__bottom p { font-weight: 720; max-width: 620px; font-size: clamp(19px, 2.3vw, 34px); }
  .opening .label { color: var(--ink); }
  .opening__next { color: var(--ink); white-space: nowrap; font-weight: 650; text-decoration: none; }
  .opening__next:hover { color: var(--ink); text-decoration: underline; }
  .hero {
    min-height: 100svh;
    padding-top: clamp(24px, 4vw, 60px);
    padding-bottom: clamp(24px, 4vw, 60px);
    align-content: center;
  }
  .hero__fig { justify-content: center; }
  .hero__fig img { max-height: calc(100svh - 155px); }
  .selected {
    min-height: 100svh;
    padding-top: clamp(24px, 4vw, 60px);
  }
  .selected .sec-head {
    padding: clamp(20px, 3vw, 48px);
    margin-bottom: clamp(24px, 3vw, 48px);
    background: var(--accent);
    border: 0;
    align-items: end;
  }
  .selected .sec-head .label { color: var(--ink); }
  .selected .sec-head h2 { line-height: .87; }
  .index {
    min-height: 100svh;
    padding-top: clamp(24px, 4vw, 60px);
  }
  .index .sec-head { border-top: 10px solid var(--accent); }
  @media (min-width: 1100px) and (prefers-reduced-motion: no-preference) {
    :global(html:has(.home-story)) { scroll-snap-type: y mandatory; scroll-behavior: smooth; }
  }
  @media (max-width: 1099px) {
    .opening { min-height: min(76svh, 840px); }
    .hero, .selected, .index { min-height: 0; }
    .hero__fig img { max-height: 75svh; }
  }
  @media (max-width: 650px) {
    .opening { padding: 22px; min-height: 65svh; }
    .opening__title { font-size: clamp(43px, 13vw, 88px); letter-spacing: -.055em; }
    .opening__bottom { align-items: end; }
    .opening__bottom p { font-size: 19px; max-width: 230px; }
    .selected .sec-head { padding: 20px; }
    .selected .sec-head h2 { font-size: clamp(41px, 9vw, 65px); }
  }
</style>
