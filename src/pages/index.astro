---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { getAllWork } from '../lib/work';

const all = await getAllWork();
const features = [
  ...all.filter((item) => item.featured && item.kind === 'Photography'),
  ...all.filter((item) => item.featured && item.kind !== 'Photography'),
];
const pageSize = 5;
const indexPages = Array.from(
  { length: Math.ceil(all.length / pageSize) },
  (_, index) => all.slice(index * pageSize, (index + 1) * pageSize),
);
const total = 1 + features.length + indexPages.length + 1;
const pad = (n: number) => String(n).padStart(2, '0');
const nextAfterIntro = features.length ? 'feature-1' : indexPages.length ? 'index-1' : 'explore';
const nextAfterFeatures = indexPages.length ? 'index-1' : 'explore';
const hero = site.hero.image;
---
<Base image={hero} sheet="Index">
  <section class="stage stage--intro wrap" id="intro" aria-labelledby="home-title">
    <div class="stage__layout intro-layout">
      <figure class="stage__figure">
        <div class="stage__image">
          <Image
            src={hero}
            alt={site.hero.alt}
            widths={[800, 1200, 1800, 2400, 3000]}
            sizes="(min-width: 760px) 73vw, 100vw"
            quality={86}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="image-caption">
          <span class="label">Photograph / 001</span>
          {site.hero.placeholder && <span class="badge">Placeholder</span>}
        </figcaption>
      </figure>
      <div class="intro-copy">
        <div class="intro-copy__top">
          <span class="label">Independent practice / Sweden</span>
          <span class="intro-copy__mark" aria-hidden="true">↗︎</span>
        </div>
        <div class="intro-copy__bottom">
          <h1 id="home-title">Axel <span>Tidehorn<b>.</b></span></h1>
          <p>Photography, product design, engineering and experiments.</p>
          <a class="chapter-link" href="/photography/">Explore photography <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
    <div class="stage__foot">
      <span class="label">01 / {pad(total)} · Introduction</span>
      <a class="stage__next" href={`#${nextAfterIntro}`}>Next composition <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  {features.map((work, i) => {
    const nextId = i + 1 < features.length ? `feature-${i + 2}` : nextAfterFeatures;
    const isPhoto = work.kind === 'Photography';
    const template = isPhoto ? 'poster' : i % 2 === 1 ? 'offset' : 'band';
    return (
      <section
        class:list={['stage', 'stage--feature', `stage--${template}`, 'wrap']}
        id={`feature-${i + 1}`}
        aria-labelledby={`feature-title-${i + 1}`}
      >
        <div class="stage__layout feature-layout">
          <figure class="stage__figure">
            <div class="stage__image">
              <Image
                src={work.cover.src}
                alt={work.cover.alt}
                widths={[480, 800, 1200, 1600, 2000]}
                sizes="(min-width: 760px) 70vw, 100vw"
                quality={86}
                loading="lazy"
              />
            </div>
            <figcaption class="image-caption">
              <span class="label">{isPhoto ? 'Photography' : 'Project'} / {pad(i + 1)}</span>
              {work.placeholder && <span class="badge">Placeholder</span>}
            </figcaption>
          </figure>
          <div class="feature-copy">
            <div class="feature-copy__top">
              <span class="label">{isPhoto ? 'Photographic work' : 'Making and experimenting'}</span>
              <span class="feature-copy__index">{pad(i + 1)}</span>
            </div>
            <div class="feature-copy__bottom">
              <h2 id={`feature-title-${i + 1}`}>{work.title}</h2>
              <p>{work.summary}</p>
              <a class="chapter-link" href={work.href}>View {isPhoto ? 'photo series' : 'project'} <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
        <div class="stage__foot">
          <span class="label">{pad(i + 2)} / {pad(total)} · {isPhoto ? 'Photography' : 'Selected project'}</span>
          <a class="stage__next" href={`#${nextId}`}>Next composition <span aria-hidden="true">↓</span></a>
        </div>
      </section>
    );
  })}

  {indexPages.map((page, pageIndex) => {
    const nextId = pageIndex + 1 < indexPages.length ? `index-${pageIndex + 2}` : 'explore';
    return (
      <section class="stage stage--index wrap" id={`index-${pageIndex + 1}`} aria-labelledby={`index-title-${pageIndex + 1}`}>
        <div class="stage__layout index-layout">
          <header class="index-heading">
            <div class="index-heading__label">
              <span class="label">Directory / {pad(pageIndex + 1)}</span>
              <span aria-hidden="true">↗</span>
            </div>
            <div class="index-heading__title">
              <h2 id={`index-title-${pageIndex + 1}`}>Index of work</h2>
              <span class="label">{pad(all.length)} total entries</span>
            </div>
          </header>
          <ol class="index-list" start={pageIndex * pageSize + 1} style={`--entries: ${page.length}`}>
            {page.map((work, itemIndex) => (
              <li>
                <a href={work.href}>
                  <span class="index-list__number">{pad(pageIndex * pageSize + itemIndex + 1)}</span>
                  <strong>{work.title}</strong>
                  <span class="index-list__kind">{work.kind}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <div class="stage__foot">
          <span class="label">{pad(2 + features.length + pageIndex)} / {pad(total)} · Directory</span>
          <a class="stage__next" href={`#${nextId}`}>Next composition <span aria-hidden="true">↓</span></a>
        </div>
      </section>
    );
  })}

  <section class="stage stage--closing wrap" id="explore" aria-labelledby="explore-title">
    <div class="stage__layout closing-layout">
      <div class="closing-layout__top">
        <span class="label">Axel Tidehorn / Index</span>
        <span class="label">Photography first. Everything else alongside it.</span>
      </div>
      <div class="closing-layout__links">
        <h2 id="explore-title">Explore.</h2>
        <a href="/photography/">Photography <span aria-hidden="true">↗</span></a>
        <a href="/projects/">Projects <span aria-hidden="true">↗</span></a>
        <a href="/about/">About <span aria-hidden="true">↗</span></a>
        <a href="/gear/">Photo gear <span aria-hidden="true">↗</span></a>
      </div>
      <div class="closing-layout__bottom">
        <span class="label">© {site.name}</span>
        <span class="label">{site.url.replace('https://', '')}</span>
      </div>
    </div>
    <div class="stage__foot">
      <span class="label">{pad(total)} / {pad(total)} · End</span>
      <a class="stage__next" href="#intro">Back to first composition <span aria-hidden="true">↑</span></a>
    </div>
  </section>
</Base>

<style>

/* One composition per screen below the header. No unbounded middle section. */
.stage {
  height: calc(100svh - var(--presentation-header-height));
  height: calc(100dvh - var(--presentation-header-height));
  min-height: 0;
  padding-block: clamp(7px, 1.2vh, 14px) 6px;
  display: grid;
  grid-template-rows: minmax(0, 1fr) 32px;
  scroll-snap-align: start;
  scroll-snap-stop: always;
}
.stage__layout { min-height: 0; min-width: 0; overflow: hidden; }
.stage__foot {
  display: flex; justify-content: space-between; align-items: center;
  min-height: 0; border-top: 1px solid var(--ink);
  gap: 8px; padding: 5px 0 0;
}
.stage__next { font: 500 11px/1.2 var(--font-mono); text-decoration: none; white-space: nowrap; }
.stage__next:hover { text-decoration: underline; }
.stage__figure { display: grid; grid-template-rows: minmax(0, 1fr) 27px; min-height: 0; min-width: 0; margin: 0; }
.stage__image { display: grid; place-items: center; min-width: 0; min-height: 0; overflow: hidden; background: var(--paper-2); }
.stage__image img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
.image-caption { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-width: 0; padding: 4px 0 0; }
.image-caption .badge { font-size: 9px; }
.chapter-link { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; border-top: 2px solid currentColor; padding-top: 8px; font-size: clamp(14px, 1.25vw, 19px); font-weight: 750; text-decoration: none; }
.chapter-link:hover { color: inherit; text-decoration: underline; }

/* Introduction: photograph first; a horizontal orange colophon rather than two columns. */
.intro-layout { display: grid; grid-template-rows: minmax(0, 1fr) clamp(142px, 26%, 220px); gap: 8px; }
.intro-layout .stage__figure { grid-row: 1; }
.intro-copy { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, .9fr); align-items: end; padding: clamp(14px, 2vw, 30px); gap: 12px 40px; min-height: 0; background: var(--accent); }
.intro-copy__top { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: start; }
.intro-copy__top .label { color: var(--ink); }
.intro-copy__mark { font-size: 24px; line-height: .7; }
.intro-copy__bottom { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, .9fr); align-items: end; gap: 10px 40px; }
.intro-copy h1 { font-size: clamp(40px, 5vw, 88px); line-height: .85; letter-spacing: -.052em; font-weight: 810; font-stretch: 73%; margin: 0; }
.intro-copy h1 b { color: var(--paper); font-weight: inherit; }
.intro-copy p { margin: 0 0 12px; font-size: clamp(16px, 1.6vw, 23px); line-height: 1.2; font-weight: 610; }
.intro-copy .chapter-link { grid-column: 2; }

/* Photography: large image and narrow editorial rail, deliberately unlike project spreads. */
.stage--poster .feature-layout { display: grid; grid-template-columns: minmax(0, 3.4fr) minmax(210px, .8fr); gap: clamp(10px, 1.5vw, 24px); }
.stage--poster .feature-copy { background: var(--paper); border-left: 10px solid var(--accent); display: flex; flex-direction: column; justify-content: space-between; padding: clamp(15px, 2vw, 30px); }
.stage--poster .feature-copy__top { display: flex; justify-content: space-between; align-items: start; gap: 12px; }
.stage--poster .feature-copy__index { color: var(--accent-ink); font-size: clamp(20px, 3.2vw, 48px); font-weight: 800; line-height: .8; }
.stage--poster .feature-copy h2 { font-size: clamp(35px, 3.6vw, 63px); letter-spacing: -.04em; line-height: .95; margin: 0 0 18px; }
.stage--poster .feature-copy p { margin: 0 0 26px; font-size: clamp(16px, 1.4vw, 21px); line-height: 1.25; }

/* Technical spread: reverse the hierarchy, dark material block left and image right. */
.stage--offset .feature-layout { display: grid; grid-template-columns: minmax(245px, .85fr) minmax(0, 1.85fr); gap: clamp(12px, 2vw, 32px); }
.stage--offset .stage__figure { grid-column: 2; grid-row: 1; }
.stage--offset .feature-copy { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(17px, 2.3vw, 36px); background: var(--ink); color: var(--paper); border-top: clamp(12px, 2vw, 28px) solid var(--accent); }
.stage--offset .feature-copy__top { display: flex; justify-content: space-between; align-items: start; gap: 10px; }
.stage--offset .feature-copy .label { color: var(--paper); }
.stage--offset .feature-copy__index { color: var(--accent); font-size: clamp(32px, 4vw, 62px); font-weight: 800; line-height: .8; }
.stage--offset .feature-copy h2 { font-size: clamp(34px, 3.7vw, 68px); letter-spacing: -.045em; line-height: .95; margin: 0 0 19px; }
.stage--offset .feature-copy p { font-size: clamp(16px, 1.4vw, 22px); line-height: 1.23; margin: 0 0 25px; }

/* Catalogue plate: image over a full-width horizontal title strip. */
.stage--band .feature-layout { display: grid; grid-template-rows: minmax(0, 1fr) clamp(146px, 27%, 220px); gap: 9px; }
.stage--band .stage__figure { grid-row: 1; }
.stage--band .feature-copy { min-height: 0; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(15px, 2vw, 28px); gap: 8px 24px; background: var(--paper-2); border-bottom: 12px solid var(--accent); }
.stage--band .feature-copy__top { display: flex; justify-content: space-between; gap: 16px; }
.stage--band .feature-copy__index { color: var(--accent-ink); font-size: 20px; line-height: .9; font-weight: 750; }
.stage--band .feature-copy__bottom { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); align-items: end; gap: 8px 24px; }
.stage--band .feature-copy h2 { font-size: clamp(31px, 3.7vw, 64px); margin: 0; line-height: .94; grid-row: 1 / 3; }
.stage--band .feature-copy p { font-size: clamp(15px, 1.35vw, 21px); line-height: 1.2; margin: 0; }
.stage--band .feature-copy .chapter-link { grid-column: 2; }

/* Index: compact poster rows, no uncontrolled free-flowing grid. */
.index-layout { display: grid; grid-template-rows: auto minmax(0, 1fr); }
.index-heading { display: grid; grid-template-columns: minmax(145px, .38fr) minmax(0, 1.62fr); border-top: 2px solid var(--ink); }
.index-heading__label { padding: clamp(12px, 1.8vw, 26px); display: flex; justify-content: space-between; gap: 12px; background: var(--accent); }
.index-heading__label > span:last-child { font-size: clamp(28px, 4vw, 52px); line-height: .8; }
.index-heading__label .label { color: var(--ink); }
.index-heading__title { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; padding: clamp(14px, 1.9vw, 28px); border-bottom: 2px solid var(--ink); }
.index-heading h2 { font-size: clamp(30px, 4.6vw, 66px); margin: 0; }
.index-list { padding: clamp(8px, 1vw, 20px) 0; margin: 0; list-style: none; display: grid; grid-template-rows: repeat(var(--entries, 5), minmax(0, 1fr)); min-height: 0; }
.index-list li { display: flex; align-items: center; min-height: 0; border-bottom: 1px solid var(--rule-soft); }
.index-list li:first-child { border-top: 1px solid var(--rule-soft); }
.index-list a { display: grid; grid-template-columns: 50px minmax(0, 1.3fr) minmax(0, .7fr) 18px; gap: 15px; align-items: center; width: 100%; padding: 6px 0; text-decoration: none; }
.index-list a:hover strong { color: var(--accent-ink); }
.index-list__number { font: 500 12px/1.2 var(--font-mono); }
.index-list strong { font-size: clamp(17px, 2.3vw, 32px); font-stretch: 77%; line-height: 1; overflow-wrap: anywhere; }
.index-list__kind { font: 400 clamp(10px, 1vw, 13px)/1.3 var(--font-mono); color: var(--ink-2); }

/* Final panel is intentionally typographic and navigational. */
.closing-layout { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; padding: clamp(20px, 3.6vw, 55px); background: var(--accent); }
.closing-layout .label { color: var(--ink); }
.closing-layout__top, .closing-layout__bottom { display: flex; justify-content: space-between; gap: 16px; }
.closing-layout__links { align-content: center; display: grid; width: min(100%, 950px); margin-inline: auto; }
.closing-layout h2 { font-size: clamp(38px, 5vw, 80px); margin: 0 0 18px; }
.closing-layout__links a { display: flex; justify-content: space-between; gap: 15px; border-top: 2px solid var(--ink); padding-block: clamp(7px, 1.4vh, 17px); font-size: clamp(23px, 3vw, 48px); font-weight: 790; font-stretch: 75%; line-height: 1.02; text-decoration: none; }
.closing-layout__links a:last-child { border-bottom: 2px solid var(--ink); }
.closing-layout__links a:hover { color: var(--ink); text-decoration: underline; }

/* Tablet variants: each stage is still exactly one framed composition. */
@media (max-width: 900px) {
  .stage--poster .feature-layout { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) minmax(130px, 26%); gap: 8px; }
  .stage--poster .feature-copy { border-left: 0; border-top: 8px solid var(--accent); padding: clamp(12px, 2vw, 22px); }
  .stage--poster .feature-copy h2 { font-size: clamp(28px, 5vw, 46px); margin-bottom: 5px; }
  .stage--poster .feature-copy p { font-size: 16px; margin-bottom: 12px; }
  .stage--offset .feature-layout { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) minmax(145px, 32%); gap: 8px; }
  .stage--offset .stage__figure { grid-column: 1; grid-row: 1; }
  .stage--offset .feature-copy { grid-column: 1; grid-row: 2; padding: clamp(12px, 2vw, 20px); border-top-width: 8px; }
  .stage--offset .feature-copy h2 { font-size: clamp(29px, 5vw, 49px); margin: 0 0 6px; }
  .stage--offset .feature-copy p { margin: 0 0 12px; font-size: 16px; }
  .stage--band .feature-layout { grid-template-rows: minmax(0, 1fr) minmax(145px, 28%); }
  .index-list a { grid-template-columns: 38px minmax(0, 1fr) 18px; }
  .index-list__kind { display: none; }
}

/* Mobile: media is the major field, the info strip uses minimal space. */
@media (max-width: 600px) {
  .stage { padding-block: 6px 4px; grid-template-rows: minmax(0, 1fr) 28px; }
  .stage__figure { grid-template-rows: minmax(0, 1fr) 23px; }
  .stage__foot { padding-top: 2px; }
  .stage__foot .label { font-size: 9px; }
  .stage__next { font-size: 9px; }
  .stage__image img { object-fit: cover; }
  .image-caption .label, .image-caption .badge { font-size: 9px; }
  .intro-layout { grid-template-rows: minmax(0, 1fr) minmax(148px, 32%); gap: 6px; }
  .intro-copy { display: flex; flex-direction: column; justify-content: space-between; gap: 4px; padding: 13px 15px; }
  .intro-copy__top { display: flex; width: 100%; }
  .intro-copy__top .label { font-size: 9px; }
  .intro-copy__mark { font-size: 20px; }
  .intro-copy__bottom { display: flex; flex-direction: column; align-items: stretch; gap: 4px; }
  .intro-copy h1 { font-size: clamp(29px, 8.7vw, 40px); line-height: .95; white-space: nowrap; }
  .intro-copy p { font-size: clamp(12px, 3.4vw, 15px); line-height: 1.12; margin: 0 0 4px; }
  .intro-copy .chapter-link { font-size: 12px; padding-top: 4px; }
  .chapter-link { padding-top: 5px; font-size: 12px; }
  .stage--poster .feature-layout, .stage--offset .feature-layout, .stage--band .feature-layout { grid-template-rows: minmax(0, 1fr) minmax(145px, 35%); gap: 6px; }
  .stage--poster .feature-copy, .stage--offset .feature-copy, .stage--band .feature-copy { display: flex; flex-direction: column; justify-content: space-between; align-items: stretch; gap: 4px; padding: 11px 14px; border-top-width: 6px; border-bottom-width: 0; }
  .stage--poster .feature-copy__top, .stage--offset .feature-copy__top, .stage--band .feature-copy__top { width: 100%; display: flex; justify-content: space-between; }
  .feature-copy__top .label { font-size: 9px; }
  .stage--poster .feature-copy__index, .stage--offset .feature-copy__index, .stage--band .feature-copy__index { font-size: 20px; }
  .stage--poster .feature-copy__bottom, .stage--offset .feature-copy__bottom, .stage--band .feature-copy__bottom { display: block; }
  .stage--poster .feature-copy h2, .stage--offset .feature-copy h2, .stage--band .feature-copy h2 { font-size: clamp(24px, 6.7vw, 32px); line-height: .93; margin: 0 0 5px; }
  .stage--poster .feature-copy p, .stage--offset .feature-copy p, .stage--band .feature-copy p { font-size: clamp(12px, 3.2vw, 14px); line-height: 1.12; margin: 0 0 7px; }
  .index-heading { grid-template-columns: 1fr; }
  .index-heading__label { align-items: center; padding: 8px 12px; }
  .index-heading__label > span:last-child { font-size: 20px; }
  .index-heading__title { padding: 10px 12px; }
  .index-heading h2 { font-size: 28px; }
  .index-list { padding-block: 8px; }
  .index-list a { gap: 6px; grid-template-columns: 30px minmax(0, 1fr) 16px; }
  .index-list strong { font-size: clamp(17px, 4.9vw, 22px); line-height: 1.05; }
  .closing-layout { padding: 16px; }
  .closing-layout__top .label:last-child { display: none; }
  .closing-layout h2 { font-size: 36px; }
  .closing-layout__links a { font-size: 25px; }
}
@media (max-height: 600px) {
  .intro-layout { grid-template-rows: minmax(0, 1fr) minmax(140px, 38%); }
  .stage--poster .feature-layout, .stage--offset .feature-layout, .stage--band .feature-layout { grid-template-rows: minmax(0, 1fr) minmax(140px, 42%); }
}
/* Below 450 CSS px, a legible page matters more than cropping essential content. */
@media (max-height: 450px) { .stage { height: auto; min-height: 520px; } }

</style>
