---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getProjects } from '../../lib/work';

const projects = await getProjects();
---
<Base title="Projects" description="Product design, engineering, software and experiments by Axel Tidehorn." sheet="Projects">
  <div class="wrap">
    <header class="sec-head rule"><span class="label">02</span><h1>Projects</h1><span class="label">{String(projects.length).padStart(2, '0')} projects</span></header>
    <div class="grid">
      {projects.map((p, i) => (
        <WorkCard
          href={`/projects/${p.id}/`}
          no={String(i + 1).padStart(2, '0')}
          title={p.data.title}
          kind={[...p.data.disciplines, p.data.status].filter(Boolean).join(' · ')}
          summary={p.data.summary}
          cover={p.data.cover}
          placeholder={p.data.placeholder}
        />
      ))}
    </div>
  </div>
</Base>

<style>
  .sec-head h1 { font-size: clamp(32px, 4vw, 52px); }
  /* Columns rounded to the major grid; the last column takes the (whole-module) remainder. */
  .grid { display: grid; gap: var(--gap); align-items: start; }
  @media (min-width: 760px) { .grid { grid-template-columns: round(down, (100% - 40px) / 2, 40px) 1fr; } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(2, round(down, (100% - 80px) / 3, 40px)) 1fr; } }
</style>
