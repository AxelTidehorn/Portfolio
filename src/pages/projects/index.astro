---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getProjects } from '../../lib/work';

const projects = await getProjects();
---
<Base title="Projects" description="Product design, engineering, software and experiments by Axel Tidehorn." sheet="Projects">
  <div class="wrap">
    <header class="sec-head pen"><span class="label">02</span><h1>Projects</h1><span class="label">{String(projects.length).padStart(2, '0')} projects</span></header>
    <div class="grid">
      {projects.map((p, i) => (
        <WorkCard
          href={`/projects/${p.id}/`}
          no={String(i + 1).padStart(2, '0')}
          title={p.data.title}
          kind={[...p.data.disciplines, p.data.status].filter(Boolean).join(' · ')}
          summary={p.data.summary}
          cover={p.data.cover}
          placeholder={p.data.placeholder}
        />
      ))}
    </div>
  </div>
</Base>

<style>
  .sec-head h1 { margin: 0; flex: 1; font-size: clamp(2rem, 4vw, 3.25rem); }
  .grid { display: grid; gap: 2.25rem 1.25rem; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); align-items: start; } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
