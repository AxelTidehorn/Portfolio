---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getProjects } from '../../lib/work';

const projects = await getProjects();
---
<Base title="Projects" description="Product design, engineering, software and experiments by Axel Tidehorn." sheet="02 Projects">
  <div class="wrap">
    <h1>Projects</h1>
    <div class="grid">
      {projects.map((p) => (
        <WorkCard
          href={`/projects/${p.id}/`}
          title={p.data.title}
          kind={[...p.data.disciplines, p.data.status].filter(Boolean).join(' · ')}
          summary={p.data.summary}
          cover={p.data.cover}
          placeholder={p.data.placeholder}
        />
      ))}
    </div>
  </div>
</Base>

<style>
  h1 { margin-bottom: 2rem; }
  .grid { display: grid; gap: 3rem 1.5rem; }
  @media (min-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); align-items: start; } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
