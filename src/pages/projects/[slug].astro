---
// Flexible project template: title block with metadata, cover, Markdown body
// (prose, CAD renders, diagrams, process images inline), then an optional gallery.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { getProjects } from '../../lib/work';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: projects[(i + 1) % projects.length] } }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const { title, summary, disciplines, status, cover, gallery, meta, links, placeholder } = entry.data;
const rows = [
  ...(disciplines.length ? [{ label: 'Discipline', value: disciplines.join(', ') }] : []),
  ...(status ? [{ label: 'Status', value: status }] : []),
  ...meta,
];
---
<Base title={title} description={summary} image={cover.src} sheet={`Projects / ${title}`}>
  <article class="wrap">
    <a class="label back" href="/projects/">← Projects</a>
    <header class="block rule">
      <div class="block__title">
        <h1>{title}</h1>
        <p>{summary}</p>
        {placeholder && <span class="badge">Placeholder</span>}
      </div>
      {rows.length > 0 && (
        <dl class="block__meta rule">
          {rows.map((r) => (<div class="rule rule--construction"><dt class="label">{r.label}</dt><dd>{r.value}</dd></div>))}
        </dl>
      )}
    </header>

    <figure class="cover snap" style={`--r: ${cover.src.height / cover.src.width}; --snap-max: 85vh`}>
      <div><Image src={cover.src} alt={cover.alt} widths={[800, 1200, 1800, 2400]} sizes="(min-width: 1600px) 1520px, 100vw" quality={85} loading="eager" /></div>
    </figure>

    <div class="body prose"><Content /></div>

    {links.length > 0 && (
      <ul class="links">{links.map((l) => <li><a href={l.href} rel="noopener">{l.label} ↗</a></li>)}</ul>
    )}

    {gallery.length > 0 && <Gallery images={gallery} label={`${title} — images`} />}

    {next.id !== entry.id && (
      <nav class="next rule" aria-label="Projects">
        <span class="label">Next project</span>
        <a href={`/projects/${next.id}/`}>{next.data.title} →</a>
      </nav>
    )}
  </article>
</Base>

<style>
  .back { display: block; width: fit-content; margin-bottom: 8px; text-decoration: none; }
  /* Outline frame; title field and metadata field split on a major-grid coordinate. */
  .block {
    --rt: var(--w-outline); --rr: var(--w-outline); --rb: var(--w-outline); --rl: var(--w-outline);
    display: grid; background: var(--paper); margin-bottom: 40px;
  }
  .block__title { padding: 16px 16px 24px; }
  .block__title p { color: var(--ink-2); max-width: 560px; margin-bottom: 8px; }
  .block__meta { --rt: var(--w-div); margin: 0; display: grid; align-content: start; }
  /* Metadata rows: 8 + 16 label + 24 value + 8 = 56px; construction-weight dividers between rows. */
  .block__meta div { --rt: var(--w-div); padding: 8px 16px; }
  .block__meta div:first-child { --rt: 0px; }
  dd { margin: 0; font-weight: 560; }
  @media (min-width: 900px) {
    .block { grid-template-columns: round(down, 62%, 40px) 1fr; }
    .block__meta { --rt: 0px; --rl: var(--w-div); }
  }
  .cover { margin: 0 0 40px; }
  .cover img { max-height: 85vh; width: auto; }
  .body { margin-bottom: 40px; }
  .links { list-style: none; padding: 0; margin: 0 0 40px; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .next { --rt: var(--w-div); display: flex; justify-content: space-between; align-items: baseline; margin-top: var(--space); padding-top: 16px; }
  .next a { font-size: 20px; line-height: 24px; font-weight: 620; font-stretch: 85%; text-decoration: none; }
</style>
