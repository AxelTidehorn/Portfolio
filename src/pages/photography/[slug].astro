---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { getSeries } from '../../lib/work';

export async function getStaticPaths() {
  const series = await getSeries();
  return series.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: series[(i + 1) % series.length] } }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const { title, summary, images, placeholder } = entry.data;
---
<Base title={title} description={summary} image={entry.data.cover.src} compact>
  <div class="wrap">
    <header class="head">
      <a class="label" href="/photography/">← Photography</a>
      <h1>{title}</h1>
      {placeholder && <span class="badge">Placeholder</span>}
      <div class="prose"><Content /></div>
    </header>
    <Gallery images={images} label={`${title} — photographs`} />
    {next.id !== entry.id && (
      <nav class="next" aria-label="Series">
        <span class="label">Next series</span>
        <a href={`/photography/${next.id}/`}>{next.data.title} →</a>
      </nav>
    )}
  </div>
</Base>

<style>
  .head { margin-bottom: 40px; max-width: var(--measure); }
  .head h1 { margin-top: 8px; font-size: clamp(32px, 4vw, 52px); }
  .head .label { text-decoration: none; }
  .head .prose { margin-top: 16px; color: var(--ink-2); }
  .next { display: flex; justify-content: space-between; align-items: baseline; margin-top: var(--space); box-shadow: inset 0 1px 0 var(--rule-soft); padding-top: 16px; }
</style>
