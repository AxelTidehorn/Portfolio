---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import { getSeries } from '../../lib/work';

export async function getStaticPaths() {
  const series = await getSeries();
  return series.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      next: series[(index + 1) % series.length],
      position: index + 1,
      total: series.length,
    },
  }));
}
const { entry, next, position, total } = Astro.props;
const { Content } = await render(entry);
const { title, summary, images, placeholder } = entry.data;
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base title={title} description={summary} image={entry.data.cover.src} compact>
  <div class="wrap series-page">
    <header class="series-head">
      <div class="series-head__top">
        <a href="/photography/">All photography</a>
        <span class="label">Series {pad(position)} / {pad(total)}</span>
      </div>
      <h1>{title}</h1>
      <div class="series-head__deck">
        <p>{summary}</p>
        <span class="label">{pad(images.length)} photographs</span>
      </div>
    </header>

    {!placeholder && (
      <div class="series-statement prose">
        <Content />
      </div>
    )}

    <Gallery images={images} label={`${title}, photographs`} />

    {next.id !== entry.id && (
      <nav class="next-series" aria-label="Other photographic series">
        <span class="label">Next photographic series</span>
        <a href={`/photography/${next.id}/`}>{next.data.title}</a>
      </nav>
    )}
  </div>
</Base>

<style>
  .series-head { border-top: 5px solid var(--accent); margin-bottom: clamp(28px, 5vw, 68px); }
  .series-head__top {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    gap: 8px 20px; padding-top: 15px; margin-bottom: clamp(22px, 3vw, 46px);
  }
  .series-head__top a { font: 500 12px/1.4 var(--font-mono); text-decoration: underline; text-underline-offset: 4px; }
  .series-head h1 {
    font-size: clamp(39px, 7vw, 106px); font-weight: 820; font-stretch: 74%;
    letter-spacing: -.052em; line-height: .93; max-width: 1250px;
    margin: 0 0 clamp(18px, 3vw, 38px);
  }
  .series-head__deck {
    display: flex; justify-content: space-between; flex-wrap: wrap;
    align-items: baseline; gap: 14px 30px;
    border-top: 1px solid var(--rule-soft); padding-top: 14px;
  }
  .series-head__deck p {
    max-width: 680px; font-size: clamp(16px, 1.8vw, 24px);
    font-weight: 450; line-height: 1.3; margin: 0;
  }
  .series-statement { margin: 0 0 clamp(28px, 4vw, 60px); color: var(--ink-2); }
  .series-statement :global(p:last-child) { margin-bottom: 0; }
  .next-series {
    display: flex; justify-content: space-between; align-items: baseline;
    flex-wrap: wrap; gap: 12px 32px;
    border-top: 7px solid var(--accent); padding-top: 18px;
    margin-top: clamp(70px, 9vw, 140px);
  }
  .next-series a { font-size: clamp(22px, 3vw, 42px); font-weight: 770; line-height: 1; text-decoration: none; }
  .next-series a:hover { text-decoration: underline; }
  @media (max-width: 640px) {
    .series-head__top { padding-top: 11px; }
    .series-head__deck p { font-size: 17px; }
    .next-series { display: block; }
    .next-series .label { display: block; margin-bottom: 12px; }
  }
</style>
