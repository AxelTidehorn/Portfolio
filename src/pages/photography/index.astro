---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getSeries } from '../../lib/work';

const series = await getSeries();
---
<Base title="Photography" description="Photographic series by Axel Tidehorn." sheet="01 Photography" image={series[0]?.data.cover.src}>
  <div class="wrap">
    <h1 class="visually-hidden">Photography</h1>
    <ol class="series">
      {series.map((s, i) => (
        <li>
          <a href={`/photography/${s.id}/`}>
            <Image src={s.data.cover.src} alt={s.data.cover.alt} widths={[640, 1000, 1500, 2000]} sizes="(min-width: 900px) 66vw, 100vw" quality={85} loading={i === 0 ? 'eager' : 'lazy'} />
          </a>
          <div class="series__text">
            <span class="label">{String(i + 1).padStart(2, '0')} · {s.data.images.length} images</span>
            <h2><a href={`/photography/${s.id}/`}>{s.data.title}</a></h2>
            <p>{s.data.summary}</p>
            {s.data.placeholder && <span class="badge">Placeholder</span>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .series { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(3rem, 8vw, 6rem); }
  .series li { display: grid; gap: 1rem; }
  .series img { max-height: 80vh; width: auto; }
  .series__text { border-top: 1px solid var(--rule); padding-top: 0.6rem; }
  .series__text h2 { margin: 0.4rem 0; }
  .series__text h2 a { text-decoration: none; }
  .series__text p { color: var(--ink-2); max-width: 30rem; }
  @media (min-width: 900px) {
    .series li { grid-template-columns: minmax(0, 3fr) minmax(14rem, 1fr); align-items: end; }
  }
</style>
