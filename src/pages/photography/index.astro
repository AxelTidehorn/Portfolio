---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getSeries } from '../../lib/work';

const series = await getSeries();
---
<Base title="Photography" description="Photographic series by Axel Tidehorn." sheet="Photography" image={series[0]?.data.cover.src}>
  <div class="wrap">
    <header class="sec-head rule"><span class="label">01</span><h1>Photography</h1><span class="label">{String(series.length).padStart(2, '0')} series</span></header>
    <div class="photo__tools"><span class="label">Behind the photographs</span><a href="/gear/">Cameras &amp; equipment ↗</a></div>
    <ol class="series">
      {series.map((s, i) => (
        <li>
          <a class="snap" href={`/photography/${s.id}/`} style={`--r: ${s.data.cover.src.height / s.data.cover.src.width}; --snap-max: 76vh`}>
            <div><Image src={s.data.cover.src} alt={s.data.cover.alt} widths={[640, 1000, 1500, 2000]} sizes="(min-width: 900px) 66vw, 100vw" quality={85} loading={i === 0 ? 'eager' : 'lazy'} /></div>
          </a>
          <div class="series__text rule">
            <span class="label">{String(i + 1).padStart(2, '0')} · {s.data.images.length} images</span>
            <h2><a href={`/photography/${s.id}/`}>{s.data.title}</a></h2>
            <p>{s.data.summary}</p>
            {s.data.placeholder && <span class="badge">Placeholder</span>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .sec-head h1 { font-size: clamp(32px, 4vw, 52px); }
  .photo__tools { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 20px; margin-bottom: 32px; padding-bottom: 12px; border-bottom: 1px solid var(--rule-soft); }
  .photo__tools a { text-decoration: none; font-weight: 650; }
  .series { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space); }
  .series li { display: grid; gap: 24px; }
  .series a.snap { display: block; }
  .series img { max-height: 76vh; width: auto; }
  .series__text { --rt: var(--w-outline); padding-top: 8px; }
  .series__text h2 { margin: 8px 0; }
  .series__text h2 a { text-decoration: none; }
  .series__text p { color: var(--ink-2); max-width: 480px; }
  @media (min-width: 1100px) {
    /* Same column split as the homepage hero: 1fr + 320px with a 40px gap. */
    .series li { grid-template-columns: minmax(0, 1fr) 320px; gap: var(--gap); align-items: end; }
  }
</style>
