---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="About" description={`About ${site.name}, photographer and design engineer.`} sheet="About">
  <div class="wrap grid">
    <div class="about__lead">
      <span class="label">About / 01</span>
      <h1>About</h1>
    </div>
    <div class="prose">
      <p class="intro">I'm Axel, a photographer and design engineer based in Sweden. I work across mechanical design, software, and practical experiments, with photography running through much of what I do.</p>
      <p>I like making things, understanding how they work, and refining the details. That might mean developing a browser-based tool for film negatives, constructing a sewing pattern, or working on a physical prototype. I photograph both digitally and on film, and I'm drawn to images with a sense of place, material, and imperfection.</p>
      <p>This site is a selection of photographs, ongoing projects, and ideas taking shape. Some are finished, some are very much works in progress.</p>

      <div class="about__links">
        <a href="/photography/">Photography <span aria-hidden="true">↗</span></a>
        <a href="/projects/">Projects <span aria-hidden="true">↗</span></a>
        <a href="/gear/">Photography gear <span aria-hidden="true">↗</span></a>
      </div>

      <h2>Contact</h2>
      {site.contact.length > 0 ? (
        <ul>{site.contact.map((c) => <li><a href={c.href}>{c.label}</a></li>)}</ul>
      ) : (
        <p class="muted">Contact details to follow.</p>
      )}
    </div>
  </div>
</Base>
<style>
  .grid { display: grid; gap: 24px var(--gap); }
  .intro { font-size: clamp(21px, 2.2vw, 29px); line-height: 1.3; font-weight: 590; font-stretch: 88%; }
  .about__lead .label { display: block; margin-bottom: 12px; }
  .about__links { margin: 32px 0 48px; border-top: 2px solid var(--rule); }
  .about__links a { display: flex; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--rule-soft); padding: 13px 0; text-decoration: none; font-weight: 650; font-size: 19px; }
  .muted { color: var(--ink-2); }
  @media (min-width: 900px) { .grid { grid-template-columns: minmax(220px, 0.75fr) minmax(0, 1.6fr); } }
</style>
