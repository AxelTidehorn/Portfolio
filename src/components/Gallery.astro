---
// Editorial gallery: original aspect ratios, generous sizes, accessible full-screen viewer.
// Works without JavaScript (each image links to its large version).
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { toRows } from '../lib/rows';

interface Props {
  images: { src: ImageMetadata; alt: string; caption?: string }[];
  label: string;
}
const { images, label } = Astro.props;
const items = await Promise.all(
  images.map(async (img, index) => ({
    ...img,
    index,
    full: (await getImage({ src: img.src, width: Math.min(img.src.width, 2560), quality: 88 })).src,
  })),
);
const rows = toRows(items);
---
<section class="gallery" aria-label={label} data-gallery>
  {rows.map((row) => (
    <div
      class:list={['row', { 'row--pair': row.length === 2 }]}
      style={row.length === 2
        ? `grid-template-columns: ${row.map((i) => `${i.src.width / i.src.height}fr`).join(' ')}`
        : undefined}
    >
      {row.map((img) => (
        <figure>
          <a href={img.full} data-index={img.index} data-full={img.full} data-caption={img.caption ?? ''}>
            <Image
              src={img.src}
              alt={img.alt}
              widths={[640, 960, 1400, 2000]}
              sizes={row.length === 2 ? '(min-width: 760px) 50vw, 100vw' : '(min-width: 1600px) 1520px, 100vw'}
              quality={85}
              loading={img.index < 2 ? 'eager' : 'lazy'}
            />
          </a>
          {img.caption && <figcaption class="label">{img.caption}</figcaption>}
        </figure>
      ))}
    </div>
  ))}

  <dialog class="viewer" aria-label="Image viewer">
    <div class="viewer__stage">
      <img alt="" />
    </div>
    <div class="viewer__bar">
      <span class="viewer__count label" aria-live="polite"></span>
      <span class="viewer__caption label"></span>
      <div class="viewer__controls">
        <button type="button" data-prev aria-label="Previous image">←</button>
        <button type="button" data-next aria-label="Next image">→</button>
        <button type="button" data-close aria-label="Close viewer">Close</button>
      </div>
    </div>
  </dialog>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const links = [...root.querySelectorAll<HTMLAnchorElement>('a[data-index]')];
    const dialog = root.querySelector('dialog')!;
    const img = dialog.querySelector('img')!;
    const count = dialog.querySelector('.viewer__count')!;
    const caption = dialog.querySelector('.viewer__caption')!;
    let current = 0;

    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const link = links[current];
      img.src = link.dataset.full!;
      img.alt = link.querySelector('img')?.alt ?? '';
      count.textContent = `${current + 1} / ${links.length}`;
      caption.textContent = link.dataset.caption ?? '';
      // Warm the cache for the next image.
      new Image().src = links[(current + 1) % links.length].dataset.full!;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    // Native dialog handles Escape and focus trapping; return focus to the opened image.
    dialog.addEventListener('close', () => links[current].focus());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    // Click on the backdrop/stage (not the image or controls) closes.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('viewer__stage')) dialog.close();
    });
    // Horizontal swipe.
    let startX = 0;
    let startY = 0;
    dialog.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; startY = e.touches[0].clientY; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .gallery { display: grid; gap: clamp(1.5rem, 5vw, 5rem); }
  .row { display: grid; gap: clamp(1rem, 2.5vw, 2rem); justify-items: center; }
  .row--pair { align-items: start; }
  @media (max-width: 759px) { .row--pair { grid-template-columns: 1fr !important; } }
  figure { margin: 0; max-width: 100%; }
  figure a { display: block; cursor: zoom-in; }
  .row:not(.row--pair) img { max-height: 88vh; width: auto; }
  figcaption { margin-top: 0.6rem; }

  .viewer {
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: var(--viewer-bg); color: #e8e6e0;
  }
  .viewer::backdrop { background: var(--viewer-bg); }
  .viewer[open] { display: grid; grid-template-rows: 1fr auto; }
  .viewer__stage { display: grid; place-items: center; min-height: 0; overflow: hidden; padding: 2vmin; }
  .viewer__stage img { max-width: 100%; max-height: calc(100dvh - 4.5rem - 4vmin); width: auto; height: auto; }
  .viewer__bar {
    display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center;
    padding: 0.5rem var(--gutter) max(0.75rem, env(safe-area-inset-bottom));
  }
  .viewer .label { color: #a9a69e; }
  .viewer__controls { display: flex; gap: 0.25rem; }
  .viewer button {
    font: 500 0.8rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em;
    background: none; color: inherit; border: 1px solid rgb(255 255 255 / 0.25);
    min-width: 2.75rem; min-height: 2.75rem; padding: 0 0.8rem; cursor: pointer;
  }
  .viewer button:hover { border-color: #fff; }
  @media (prefers-reduced-motion: no-preference) {
    .viewer[open] { animation: fade 160ms ease-out; }
    @keyframes fade { from { opacity: 0; } }
  }
</style>
