---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  kind: string;
  no?: string; // optional item number shown in the metadata row
  summary?: string;
  cover: { src: ImageMetadata; alt: string };
  placeholder?: boolean;
  sizes?: string;
}
const { href, title, kind, no, summary, cover, placeholder, sizes = '(min-width: 760px) 40vw, 100vw' } = Astro.props;
---
<article class="card">
  <a href={href}>
    <div class="snap" style={`--r: ${cover.src.height / cover.src.width}`}>
      <div><Image src={cover.src} alt={cover.alt} widths={[480, 800, 1200, 1600]} sizes={sizes} quality={82} /></div>
    </div>
    <div class="card__meta rule">
      {no && <span class="label card__no">{no}</span>}
      <span class="label">{kind}</span>
      {placeholder && <span class="badge">Placeholder</span>}
    </div>
    <h3>{title}</h3>
  </a>
  {summary && <p>{summary}</p>}
</article>

<style>
  .card a { text-decoration: none; display: block; }
  .card img { width: 100%; background: var(--paper-2); }
  .card__meta {
    --rt: var(--w-div);
    display: flex; align-items: center; gap: 16px;
    margin-top: 8px; padding: 8px 0 0; min-height: 32px; /* 8 + 16px label lines; wraps in 16px steps */
  }
  .card__meta .badge { margin-left: auto; }
  .card__no { color: var(--ink); }
  h3 { margin: 8px 0 0; }
  .card a:hover h3 { color: var(--accent); }
  p { color: var(--ink-2); margin: 8px 0 0; max-width: 560px; }
</style>
