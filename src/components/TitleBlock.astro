---
/* Editorial masthead inspired by Scandinavian industrial manuals, not a literal engineering drawing. */
import Logo from './Logo.astro';
import { site } from '../data/site';
interface Props { compact?: boolean; sheet?: string; }
const { compact = false } = Astro.props;
const path = Astro.url.pathname;
---
<header class:list={['masthead', { 'masthead--compact': compact }]}>
  <div class="wrap masthead__inner">
    <a class="masthead__identity" href="/" aria-label={`${site.name} — home`}>
      <span class="masthead__mark"><Logo /></span>
      <span class="masthead__brand">
        <strong>{site.name}</strong>
        {!compact && <span class="masthead__descriptor">Photography / Product design / Engineering</span>}
      </span>
    </a>
    <nav class="masthead__nav" aria-label="Main navigation">
      {site.nav.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
          <span class="label">{item.code}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</header>
<style>
  .masthead { padding-top: clamp(16px, 2.6vw, 32px); margin-bottom: clamp(24px, 3.5vw, 48px); }
  .masthead__inner {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: clamp(20px, 3vw, 48px);
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .masthead__identity {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 18px;
    text-decoration: none;
    padding: 14px 0;
  }
  .masthead__mark { flex: none; width: clamp(46px, 5vw, 68px); height: clamp(46px, 5vw, 68px); display: grid; place-items: center; }
  .masthead__mark :global(svg) { width: 100%; height: 100%; }
  .masthead__brand { display: flex; flex-direction: column; gap: 4px; }
  .masthead__brand strong {
    font-size: clamp(26px, 3.5vw, 48px);
    line-height: 0.98;
    font-weight: 800;
    font-stretch: 75%;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  .masthead__descriptor { font: 500 11px/1.5 var(--font-mono); color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.025em; }
  .masthead__nav { display: flex; align-items: stretch; margin-left: auto; }
  .masthead__nav a {
    min-width: 104px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    border-left: 1px solid var(--rule-soft);
    text-decoration: none;
    font-size: 16px;
    font-weight: 650;
    font-stretch: 85%;
  }
  .masthead__nav a[aria-current='page'] { box-shadow: inset 0 -4px 0 var(--ink); }
  .masthead__nav .label { color: var(--ink-2); }
  .masthead--compact .masthead__inner { border-top-width: 2px; }
  .masthead--compact .masthead__mark { width: 38px; height: 38px; }
  .masthead--compact .masthead__brand strong { font-size: clamp(20px, 2.2vw, 30px); }
  .masthead--compact .masthead__nav a { padding-block: 10px; }
  @media (max-width: 900px) {
    .masthead__inner { flex-wrap: wrap; gap: 0; }
    .masthead__identity { width: 100%; }
    .masthead__nav { width: 100%; margin: 0; border-top: 1px solid var(--rule-soft); }
    .masthead__nav a { flex: 1; min-width: 0; padding: 12px; }
    .masthead__nav a:first-child { border-left: 0; }
  }
  @media (max-width: 480px) {
    .masthead__identity { gap: 12px; }
    .masthead__brand strong { font-size: clamp(24px, 7vw, 34px); }
    .masthead__descriptor { font-size: 9px; }
    .masthead__nav a { font-size: 14px; padding-inline: 9px; }
  }
</style>
