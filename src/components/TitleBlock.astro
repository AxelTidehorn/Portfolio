---
// Header modelled on an engineering drawing title block (ritningshuvud).
// `compact` gives the restrained single-row variant used on gallery/detail pages.
import Logo from './Logo.astro';
import { site } from '../data/site';

interface Props {
  compact?: boolean;
  sheet?: string; // name of the current section, shown in the block
}
const { compact = false, sheet = 'Index' } = Astro.props;
const path = Astro.url.pathname;
const current = site.nav.find((item) => path.startsWith(item.href));
const sheetNo = `${current?.code ?? '00'} / ${String(site.nav.length).padStart(2, '0')}`;
---
<header class:list={['tb', { 'tb--compact': compact }]}>
  <div class="wrap">
    <div class="tb__grid pen sheet">
      <a class="tb__logo cell pen" href="/" aria-label={`${site.name} — home`}><Logo /></a>
      <a class="tb__name cell pen" href="/">
        {!compact && <span class="label">Title</span>}
        <span class="tb__title">{site.name}</span>
        {!compact && <span class="tb__disc">{site.disciplines.join(' · ')}</span>}
      </a>
      <nav class="tb__nav" aria-label="Main">
        {site.nav.map((item) => (
          <a class="cell pen" href={item.href} aria-current={item === current ? 'page' : undefined}>
            <span class="label">{item.code}</span>
            <span class="tb__link">{item.label}</span>
          </a>
        ))}
      </nav>
      {!compact && (
        <div class="tb__meta">
          <div class="cell pen tb__sheet"><span class="label">Sheet</span><span>{sheet}</span></div>
          <div class="cell pen"><span class="label">No.</span><span>{sheetNo}</span></div>
          <div class="cell pen tb__opt"><span class="label">Scale</span><span>1:1</span></div>
          <div class="cell pen tb__opt tb__proj" title="First-angle projection">
            <svg viewBox="0 0 40 20" width="40" height="20" aria-hidden="true">
              <polygon points="3,7.5 17,3 17,17 3,12.5" />
              <circle cx="30" cy="10" r="7" />
              <circle cx="30" cy="10" r="3" />
              <line x1="1" y1="10" x2="39" y2="10" stroke-dasharray="4 1.5 1 1.5" />
            </svg>
            <span class="visually-hidden">First-angle projection</span>
          </div>
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .tb { padding-top: calc(var(--gutter) * 0.75); margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .tb__grid {
    display: grid;
    grid-template-columns: 5rem 1fr;
    grid-template-areas: 'logo name' 'nav nav' 'meta meta';
    --pen: 2px; /* heavy outer frame */
  }
  .cell {
    --pen: 0 1px 1px 0; /* thin inner rules */
    display: flex; flex-direction: column; gap: 0.15rem;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    min-width: 0;
  }
  .tb__logo { grid-area: logo; display: grid; place-items: center; padding: 0.7rem; }
  .tb__logo > :global(*) { width: 100%; aspect-ratio: 1; height: auto; }
  .tb__name { grid-area: name; justify-content: center; }
  .tb__title {
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    font-weight: 720; font-stretch: 78%;
    letter-spacing: -0.02em; line-height: 1;
  }
  .tb__disc { font-size: 0.82rem; color: var(--ink-2); font-stretch: 90%; }
  .tb__nav { grid-area: nav; display: grid; grid-template-columns: repeat(3, 1fr); }
  .tb__link { font-weight: 560; font-size: 1.02rem; }
  .tb__nav a[aria-current='page'] { background: var(--ink); color: var(--paper); }
  .tb__nav a[aria-current='page'] .label { color: var(--paper); opacity: 0.65; }
  .tb__meta { grid-area: meta; display: grid; grid-template-columns: 1fr auto; }
  .tb__meta .cell { flex-direction: row; align-items: baseline; gap: 0.6rem; font-size: 0.9rem; }
  .tb__opt { display: none !important; }
  .tb__proj { align-items: center !important; justify-content: center; }
  .tb__proj svg { fill: none; stroke: var(--ink); stroke-width: 1; filter: url(#pen); }

  @media (min-width: 900px) {
    .tb__grid {
      grid-template-columns: 7.25rem minmax(17rem, 1.25fr) 3fr;
      grid-template-areas: 'logo name nav' 'logo name meta';
    }
    .tb__nav .cell { padding: 0.65rem 0.9rem; }
    .tb__meta { grid-template-columns: 2.2fr 1fr 0.8fr auto; }
    .tb__opt { display: flex !important; }
    .tb__proj { padding-inline: 1rem; }
  }

  /* Compact: one row, lighter rules, no metadata. */
  .tb--compact { margin-bottom: clamp(1.5rem, 3.5vw, 3rem); }
  .tb--compact .tb__grid { --pen: 1px; --pen-color: var(--rule-soft); grid-template-areas: 'logo name' 'nav nav'; grid-template-columns: 3rem 1fr; background: none; }
  .tb--compact .cell { --pen-color: var(--rule-soft); }
  /* Galleries stay quiet: crisp rules, no pen texture. */
  .tb--compact .pen::after { filter: none; }
  .tb--compact .tb__logo { padding: 0.45rem; }
  .tb--compact .tb__title { font-size: 1.2rem; }
  @media (min-width: 900px) {
    .tb--compact .tb__grid {
      grid-template-columns: 3.25rem auto 1fr;
      grid-template-areas: 'logo name nav';
    }
    .tb--compact .tb__nav { grid-template-columns: repeat(3, minmax(0, 11rem)); justify-content: end; }
    .tb--compact .tb__nav .cell { flex-direction: row; gap: 0.6rem; align-items: baseline; padding-block: 0.8rem; }
  }
</style>
