---
import Logo from './Logo.astro';
import { site } from '../data/site';
interface Props { compact?: boolean; sheet?: string; }
const { compact = false } = Astro.props;
const path = Astro.url.pathname;
---
<header class:list={['masthead', { 'masthead--compact': compact }]}>
  <div class="wrap masthead__inner">
    <a class="masthead__identity" href="/" aria-label={`${site.name}, home`}>
      <span class="masthead__mark"><Logo /></span>
    </a>
    <nav class="masthead__nav" aria-label="Main navigation">
      {site.nav.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</header>
<style>
  .masthead { margin: 0 0 clamp(12px, 2vw, 28px); }
  .masthead__inner {
    display: flex; justify-content: space-between; align-items: center;
    gap: clamp(16px, 3vw, 48px);
    min-height: clamp(68px, 6vw, 94px);
    border-bottom: 2px solid var(--ink);
  }
  .masthead__identity { display: inline-flex; align-items: center; flex: none; text-decoration: none; padding: 10px 0; }
  .masthead__mark { display: block; width: clamp(40px, 4.8vw, 62px); height: clamp(40px, 4.8vw, 62px); }
  .masthead__mark :global(svg) { width: 100%; height: 100%; }
  .masthead__nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 48px); }
  .masthead__nav a {
    text-decoration: none; position: relative; display: block; padding: 20px 0;
    font-size: clamp(14px, 1.3vw, 17px); line-height: 1.2;
    font-weight: 680; font-stretch: 82%; letter-spacing: -0.015em;
  }
  .masthead__nav a:hover { color: var(--accent-ink); }
  .masthead__nav a[aria-current='page']::after {
    content: ''; position: absolute; bottom: 0; left: 0; right: 0;
    height: 4px; background: var(--accent);
  }
  .masthead--compact .masthead__mark { width: 38px; height: 38px; }

  /* A stable header height is part of the homepage composition, not an overlay. */
  :global(body.homepage-presentation) .masthead {
    flex: 0 0 var(--presentation-header-height);
    height: var(--presentation-header-height);
    position: relative; z-index: 40;
    margin-bottom: 0; background: var(--paper);
  }
  :global(body.homepage-presentation) .masthead__inner {
    height: var(--presentation-header-height);
    min-height: 0;
  }
  /* Prevent the 62px logo plus 20px padding from exceeding a 68px header. */
  :global(body.homepage-presentation) .masthead__identity { padding-block: 4px; }
  :global(body.homepage-presentation) .masthead__mark {
    width: clamp(38px, 4vw, 52px);
    height: clamp(38px, 4vw, 52px);
  }
  @media (max-width: 480px) {
    .masthead__inner { min-height: 70px; }
    .masthead__nav { gap: clamp(10px, 3vw, 20px); }
    .masthead__nav a { font-size: 13px; padding: 22px 0; }
    .masthead__mark { width: 38px; height: 38px; }
  }
</style>
