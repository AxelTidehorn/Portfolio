---
// Header modelled on an engineering drawing title block (ritningshuvud).
// Every cell boundary sits on a grid coordinate: fixed columns are multiples of 40px (8px on
// phones), proportional columns are rounded down to the module and the last column takes the
// remainder, which is then also a whole number of modules. Row heights are multiples of 8px.
// `compact` gives the restrained single-row variant used on gallery/detail pages.
import Logo from './Logo.astro';
import { site } from '../data/site';

interface Props {
  compact?: boolean;
  sheet?: string; // name of the current section, shown in the block
}
const { compact = false, sheet = 'Index' } = Astro.props;
const path = Astro.url.pathname;
const current = site.nav.find((item) => path.startsWith(item.href));
const sheetNo = `${current?.code ?? '00'} / ${String(site.nav.length).padStart(2, '0')}`;
---
<header class:list={['tb', { 'tb--compact': compact }]}>
  <div class="wrap">
    <div class="tb__grid rule">
      <a class="tb__logo cell rule" href="/" aria-label={`${site.name} — home`}><Logo /></a>
      <a class="tb__name cell rule" href="/">
        {!compact && <span class="label">Title</span>}
        <span class="tb__title">{site.name}</span>
        {!compact && <span class="tb__disc">{site.disciplines.join(' · ')}</span>}
      </a>
      <nav class="tb__nav" aria-label="Main">
        {site.nav.map((item) => (
          <a class="cell rule" href={item.href} aria-current={item === current ? 'page' : undefined}>
            <span class="label">{item.code}</span>
            <span class="tb__link">{item.label}</span>
          </a>
        ))}
      </nav>
      {!compact && (
        <div class="tb__meta">
          <div class="cell rule"><span class="label">Sheet</span><span>{sheet}</span></div>
          <div class="cell rule"><span class="label">No.</span><span>{sheetNo}</span></div>
          <div class="cell rule tb__opt"><span class="label">Scale</span><span>1:1</span></div>
          <div class="cell rule tb__opt tb__proj" title="First-angle projection">
            <svg viewBox="0 0 40 20" width="40" height="20" aria-hidden="true">
              <polygon points="3,7.5 17,3 17,17 3,12.5" />
              <circle cx="30" cy="10" r="7" />
              <circle cx="30" cy="10" r="3" />
              <line class="cl" x1="0" y1="10" x2="40" y2="10" />
            </svg>
            <span class="visually-hidden">First-angle projection</span>
          </div>
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .tb { padding-top: 16px; margin-bottom: 24px; }
  .tb__grid {
    /* Outline weight on all four sides. */
    --rt: var(--w-outline); --rr: var(--w-outline); --rb: var(--w-outline); --rl: var(--w-outline);
    display: grid;
    background: var(--paper);
    grid-template-columns: 80px 1fr;
    grid-template-rows: 80px 64px 40px;
    grid-template-areas: 'logo name' 'nav nav' 'meta meta';
  }
  .cell {
    /* Division weight; each cell draws its own top and left line. */
    --rt: var(--w-div); --rl: var(--w-div); --rr: 0px; --rb: 0px;
    display: flex; flex-direction: column; justify-content: center;
    padding: 0 16px;
    text-decoration: none;
    min-width: 0;
  }
  .tb__logo { grid-area: logo; align-items: center; padding: 12px; }
  .tb__logo > :global(*) { width: 100%; height: 100%; }
  .tb__name { grid-area: name; }
  .tb__title {
    font-size: 26px; line-height: 32px;
    font-weight: 720; font-stretch: 78%; letter-spacing: -0.02em;
  }
  .tb__disc { font-size: 13px; line-height: 16px; color: var(--ink-2); font-stretch: 90%; }
  .tb__nav { grid-area: nav; display: grid; grid-template-columns: repeat(2, round(down, 33.333%, 8px)) 1fr; }
  .tb__link { font-weight: 560; font-size: 16px; line-height: 24px; }
  .tb__nav a[aria-current='page'] { background: var(--ink); color: var(--paper); }
  .tb__nav a[aria-current='page'] .label { color: var(--paper); opacity: 0.65; }
  .tb__meta { grid-area: meta; display: grid; grid-template-columns: 1fr 120px; }
  .tb__meta .cell { flex-direction: row; justify-content: flex-start; align-items: center; gap: 8px; font-size: 14px; line-height: 24px; }
  .tb__opt { display: none !important; }
  .tb__meta .tb__proj { justify-content: center; padding: 0; }
  .tb__proj svg { fill: none; stroke: var(--ink); stroke-width: 1; }
  .tb__proj .cl { stroke-width: 0.5; stroke-dasharray: 6 1.5 1.5 1.5; } /* chain line: centre-line convention */

  @media (min-width: 760px) {
    .tb { padding-top: 40px; margin-bottom: 40px; }
    .tb__nav { grid-template-columns: repeat(2, round(down, 33.333%, 40px)) 1fr; }
    .tb__meta { grid-template-columns: 1fr 160px 120px 80px; }
    .tb__opt { display: flex !important; }
  }
  @media (min-width: 1100px) {
    .tb__grid {
      grid-template-columns: 120px round(down, (100% - 120px) * 0.3, 40px) 1fr;
      grid-template-rows: 72px 48px;
      grid-template-areas: 'logo name nav' 'logo name meta';
    }
    .tb__logo { padding: 20px; }
    .tb__title { font-size: 34px; line-height: 40px; }
    .tb__nav .cell { padding: 0 16px; }
  }

  /* Compact: one row, lighter lines, no metadata. Same geometry rules. */
  .tb--compact .tb__grid {
    --rule-c: var(--rule-soft); --rt: var(--w-div); --rr: var(--w-div); --rb: var(--w-div); --rl: var(--w-div);
    grid-template-columns: 56px 1fr; grid-template-rows: 56px 56px;
    grid-template-areas: 'logo name' 'nav nav';
    background: none;
  }
  .tb--compact .cell { --rule-c: var(--rule-soft); }
  .tb--compact .tb__logo { padding: 8px; }
  .tb--compact .tb__title { font-size: 20px; line-height: 24px; }
  @media (min-width: 760px) {
    .tb--compact .tb__grid {
      grid-template-columns: 56px auto 1fr;
      grid-template-rows: 56px;
      grid-template-areas: 'logo name nav';
    }
    .tb--compact .tb__nav { grid-template-columns: repeat(3, 160px); justify-content: end; }
    .tb--compact .tb__nav .cell { flex-direction: row; justify-content: flex-start; align-items: center; gap: 8px; }
  }
</style>
