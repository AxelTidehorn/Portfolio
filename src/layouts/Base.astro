---
import '../styles/global.css';
import TitleBlock from '../components/TitleBlock.astro';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata; // social share image
  compact?: boolean;
  sheet?: string;
}
const { title, description = site.description, image, compact, sheet } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f3f0e8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={new URL(og.src, Astro.site)} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
  </head>
  <body class:list={{ quiet: compact, 'homepage-presentation': sheet === 'Index' }}>
    <a class="skip" href="#main">Skip to content</a>
    <TitleBlock compact={compact} sheet={sheet} />
    <main id="main">
      <slot />
    </main>
    <footer class="wrap">
      <div class="foot rule">
        <span class="label">© {site.name}</span>
        <span class="label">{site.url.replace('https://', '')}</span>
        <a class="label" href="#main">Top ↑</a>
      </div>
    </footer>
  </body>
</html>

<style>
  main { padding-bottom: var(--space); }
  .foot {
    --rt: var(--w-div);
    display: flex; justify-content: space-between; gap: 16px;
    padding-block: 16px 40px;
  }
  .foot a { text-decoration: none; }

  /*
   * Home is a contained presentation: the header occupies a fixed row
   * and main owns the ONLY vertical scrollport below it. Snapping the
   * root document previously left slides partially behind the header.
   */
  :global(html:has(body.homepage-presentation)) {
    --presentation-header-height: clamp(68px, 7svh, 84px);
    height: 100%;
    overflow: hidden;
  }
  :global(body.homepage-presentation) {
    display: flex;
    flex-direction: column;
    height: 100svh;
    height: 100dvh;
    overflow: hidden;
  }
  :global(body.homepage-presentation) main {
    flex: 1 1 auto;
    min-height: 0;
    padding-bottom: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    scroll-snap-type: y mandatory;
    scroll-padding-block: 0;
  }
  :global(body.homepage-presentation) > footer.wrap { display: none; }

  /* On short viewports, the individual slide contents can flow and be read
     in full rather than being clipped to a screen-height rectangle. */
  @media (max-height: 570px), (prefers-reduced-motion: reduce) {
    :global(body.homepage-presentation) main { scroll-snap-type: none; }
  }
</style>
